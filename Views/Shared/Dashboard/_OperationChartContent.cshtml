@{
    var operationChartArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase)
        ? "/admin"
        : "/home";
}

<style>
 .oc-page { --oc-accent:#e5a11b; --oc-line:#8fd1e3; }
 .oc-head { display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap; margin-bottom:18px; }
 .oc-head h1 { margin:0; font-size:clamp(1.45rem,2.5vw,2.15rem); }
 .oc-head p { margin:6px 0 0; color:var(--text-2); font-size:13px; }
 .oc-filters { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
 .oc-filter { display:flex; align-items:center; gap:7px; padding:8px 11px; border:1px solid var(--card-border); border-radius:9px; background:var(--card-bg); color:var(--text-2); font-size:12px; }
 .oc-filter select { min-width:105px; border:0; outline:0; background:transparent; color:var(--text); font-weight:700; }
 .oc-meta { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; color:var(--text-2); font-size:12px; }
 .oc-legend { display:flex; flex-wrap:wrap; gap:7px; }
 .oc-legend span { display:inline-flex; align-items:center; gap:5px; padding:4px 8px; border:1px solid var(--card-border); border-radius:999px; background:var(--card-bg); }
 .oc-legend i { color:var(--oc-accent); }
 .oc-board { overflow:auto; min-height:480px; padding:32px 28px 52px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:radial-gradient(circle at 50% 0%, color-mix(in srgb,var(--oc-line) 11%,transparent), transparent 34%), var(--card-bg); box-shadow:var(--shadow-sm); }
 .oc-tree { display:flex; justify-content:center; min-width:max-content; direction:ltr; }
 .oc-tree ul { position:relative; display:flex; justify-content:center; gap:32px; margin:0; padding:48px 14px 0; list-style:none; }
 .oc-tree > ul { padding-top:0; }
 .oc-tree li { position:relative; display:flex; flex-direction:column; align-items:center; padding:48px 10px 0; }
 .oc-tree > ul > li { padding-top:0; }
 .oc-tree li::before,.oc-tree li::after { position:absolute; top:23px; z-index:0; content:""; border-top:2px dotted var(--oc-line); }
 .oc-tree > ul > li::before,.oc-tree > ul > li::after { display:none; }
 .oc-tree li::before { right:50%; width:calc(50% + 10px); }
 .oc-tree li::after { left:50%; width:calc(50% + 10px); }
 .oc-tree li:only-child::before,.oc-tree li:only-child::after { display:none; }
 .oc-tree ul ul::before { position:absolute; top:0; left:50%; height:48px; content:""; border-left:2px dotted var(--oc-line); }
  .oc-item-parent-head > ul,
  .oc-item-parent-store > ul { flex-direction:column; align-items:center; gap:22px; }
  .oc-item-parent-head > ul { width:min(100%, 760px); align-items:stretch; }
  .oc-item-parent-head > ul > li { display:grid; width:100%; grid-template-columns:154px minmax(260px,1fr); align-items:start; column-gap:20px; padding-top:0; }
  .oc-item-parent-head > ul > li > ul { display:flex; width:100%; flex-direction:column; align-items:stretch; gap:12px; margin:0; padding:0 0 0 18px; border-left:2px dotted var(--oc-line); }
  .oc-item-parent-head > ul > li > ul::before { display:none; }
  .oc-item-parent-head > ul > li > ul > li { width:100%; align-items:flex-start; padding:0; }
  .oc-item-parent-head > ul > li > ul > li::before,
  .oc-item-parent-head > ul > li > ul > li::after { display:none; }
  .oc-item-parent-store > ul::before { height:100%; }
  .oc-item-parent-head > ul > li::before,
  .oc-item-parent-head > ul > li::after,
  .oc-item-parent-store > ul > li::before,
  .oc-item-parent-store > ul > li::after { display:none; }
  .oc-node { position:relative; z-index:1; display:flex; width:154px; flex-direction:column; align-items:center; border:0; background:transparent; color:var(--text); text-align:center; }
  .oc-node.oc-person-open { padding:0; font-family:inherit; cursor:pointer; }
  .oc-node.oc-person-open:focus-visible { outline:3px solid color-mix(in srgb,var(--node-color) 35%,transparent); outline-offset:6px; border-radius:8px; }
  .oc-node strong { display:block; max-width:160px; margin-top:8px; color:var(--text); font-size:12px; line-height:1.3; }
  .oc-node small { display:block; max-width:160px; margin-top:3px; color:var(--text-2); font-size:10px; line-height:1.3; }
 .oc-avatar { display:flex; width:58px; height:58px; align-items:center; justify-content:center; border:3px solid color-mix(in srgb,var(--node-color) 32%,white); border-radius:50%; background:var(--node-color); box-shadow:0 2px 0 color-mix(in srgb,var(--node-color) 20%,transparent), 0 5px 12px rgba(24,39,75,.13); color:#fff; font-size:25px; }
  .oc-node.oc-root { --node-color:#e5a11b; }
  .oc-node.oc-director { --node-color:#4777d9; }
  .oc-node.oc-manager { --node-color:#805ad5; }
  .oc-node.oc-senior { --node-color:#008b8b; }
  .oc-node.oc-consultant { --node-color:#168a5b; }
  .oc-node.oc-head { --node-color:#c47f19; }
  .oc-node.oc-store { --node-color:#3da8c4; cursor:pointer; text-decoration:none; }
 .oc-node.oc-store:hover .oc-avatar { transform:translateY(-2px); box-shadow:0 5px 15px rgba(24,39,75,.2); }
  .oc-store-link { color:inherit; text-decoration:none; }
  .oc-store-link:hover strong { color:var(--node-color); }
 .oc-node em { display:inline-flex; align-items:center; gap:4px; margin-top:6px; padding:3px 8px; border:1px solid color-mix(in srgb,var(--node-color) 24%,var(--card-border)); border-radius:999px; background:color-mix(in srgb,var(--node-color) 8%,var(--card-bg)); color:var(--node-color); font-size:10px; font-style:normal; font-weight:800; }
 .oc-empty { padding:50px 16px; text-align:center; color:var(--text-2); }
 .oc-loading { display:flex; align-items:center; justify-content:center; gap:8px; padding:50px 16px; color:var(--text-2); }
  .oc-home-guide { display:flex; align-items:center; justify-content:center; gap:6px; margin:0 0 22px; color:var(--text-2); font-size:12px; }
  .oc-home-guide i { color:var(--oc-accent); }
  .oc-detail-view { width:min(100%,980px); margin:0 auto; }
  .oc-back { display:inline-flex; align-items:center; gap:7px; margin-bottom:22px; padding:8px 12px; border:1px solid var(--card-border); border-radius:8px; background:var(--card-bg); color:var(--text-2); cursor:pointer; font:inherit; font-size:12px; }
  .oc-back:hover { border-color:var(--oc-accent); color:var(--oc-accent); }
  .oc-detail-flow { display:flex; flex-direction:column; align-items:center; }
  .oc-detail-hero { display:flex; flex-direction:column; align-items:center; }
  .oc-detail-hero .oc-detail-card { min-width:220px; }
  .oc-detail-section { position:relative; width:100%; padding-top:38px; }
  .oc-detail-section::before { position:absolute; top:0; left:50%; height:28px; content:""; border-left:2px dotted var(--oc-line); }
  .oc-detail-section h3 { margin:0 0 14px; color:var(--text-2); font-size:12px; font-weight:800; text-align:center; }
  .oc-detail-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:18px; }
  .oc-detail-card { display:flex; min-height:124px; flex-direction:column; align-items:center; justify-content:center; padding:14px 12px; border:1px solid var(--card-border); border-radius:12px; background:var(--card-bg); box-shadow:var(--shadow-sm); text-align:center; }
  .oc-detail-card.oc-root { --node-color:#e5a11b; }
  .oc-detail-card.oc-role { --node-color:#e5a11b; }
  .oc-detail-card.oc-store { --node-color:#3da8c4; }
  .oc-detail-card.oc-leader { --node-color:#5c9c6a; }
  .oc-detail-card .oc-avatar { width:50px; height:50px; font-size:21px; }
  .oc-detail-card strong { display:block; margin-top:8px; color:var(--text); font-size:13px; line-height:1.3; }
  .oc-detail-card small { display:block; margin-top:4px; color:var(--text-2); font-size:10.5px; }
  .oc-stores-list { display:flex; flex-direction:column; gap:10px; }
  .oc-detail-store { display:flex; align-items:center; gap:12px; width:100%; padding:13px 15px; border:1px solid var(--card-border); border-radius:10px; background:var(--card-bg); color:var(--text); text-decoration:none; box-shadow:var(--shadow-sm); }
  .oc-detail-store:hover { border-color:#3da8c4; }
  .oc-detail-store .oc-store-icon { display:flex; width:38px; height:38px; flex:0 0 38px; align-items:center; justify-content:center; border-radius:50%; background:#3da8c4; color:#fff; }
  .oc-detail-store strong { display:block; font-size:13px; }
  .oc-detail-store small { display:block; margin-top:3px; color:var(--text-2); font-size:11px; }
  .oc-detail-empty { padding:26px 12px; color:var(--text-2); text-align:center; }
 @@media (max-width:700px) {
     .oc-head { display:block; }
     .oc-filters { margin-top:14px; }
     .oc-board { min-height:400px; padding-right:16px; padding-left:16px; }
     .oc-tree ul { gap:16px; }
     .oc-tree li { padding-right:4px; padding-left:4px; }
     .oc-node { width:140px; }
     .oc-avatar { width:50px; height:50px; font-size:21px; }
     .oc-detail-grid { grid-template-columns:1fr; }
     .oc-detail-card { min-height:108px; }
 }
</style>

<div class="oc-page" id="operationChartRoot"
     data-area-prefix="@operationChartArea"
     data-title="@L["Page_OperationChart"]"
     data-subtitle="@L["Page_OperationChartSub"]"
     data-loading="@L["OC_Loading"]"
     data-no-data="@L["OC_NoData"]"
     data-stores="@L["OC_Stores"]"
     data-store="@L["OC_Store"]"
     data-general-manager="@L["OC_GeneralManager"]"
     data-assistant-general-manager="@L["OC_AssistantGeneralManager"]"
     data-general-manager-name="@L["OC_GeneralManagerName"]"
     data-assistant-general-manager-name="@L["OC_AssistantGeneralManagerName"]"
     data-operation-director="@L["OC_OperationDirector"]"
     data-operation-manager="@L["OC_OperationManager"]"
     data-senior-operation-consultant="@L["OC_SeniorOperationConsultant"]"
     data-operation-consultant="@L["OC_OperationConsultant"]"
     data-head-manager="@L["OC_HeadManager"]"
     data-store-leader="@L["OC_StoreLeader"]"
     data-click-to-extend="@L["OC_ClickToExtend"]"
     data-back="@L["OC_Back"]"
     data-no-subordinates="@L["OC_NoSubordinates"]"
     data-store-leader-line="@L["OC_StoreLeaderLine"]">
    <div class="oc-head">
        <div>
            <h1>@L["Page_OperationChart"]</h1>
            <p>@L["Page_OperationChartSub"]</p>
        </div>
        <div class="oc-filters">
            <label class="oc-filter"><i class="bi bi-calendar3"></i><span>@L["Common_Year"]</span><select id="ocYear"></select></label>
            <label class="oc-filter"><i class="bi bi-calendar-month"></i><span>@L["Common_Month"]</span><select id="ocMonth"></select></label>
        </div>
    </div>
    <div class="oc-meta">
        <span id="ocPeriodLabel"></span>
        <div class="oc-legend">
            <span><i class="bi bi-person-badge"></i>@L["OC_Leadership"]</span>
            <span><i class="bi bi-shop"></i>@L["OC_Stores"]</span>
            <span><i class="bi bi-person-check"></i>@L["OC_StoreLeader"]</span>
        </div>
    </div>
    <div class="oc-board" id="ocBoard">
        <div class="oc-loading"><span class="spinner-border spinner-border-sm"></span>@L["OC_Loading"]</div>
    </div>
</div>

<script>
(function () {
    const root = document.getElementById('operationChartRoot');
    if (!root) return;
    const d = root.dataset;
    const $ = id => document.getElementById(id);
    const esc = value => typeof sapEscape === 'function' ? sapEscape(value ?? '') : String(value ?? '');
    const clean = value => String(value ?? '').trim();
     const monthLabel = month => {
         const monthNumber = Number(month);
         if (!Number.isInteger(monthNumber) || monthNumber < 1 || monthNumber > 12) return '';
         const locale = document.documentElement.lang?.toLowerCase().startsWith('ar') ? 'ar-EG' : 'en-US';
         return new Intl.DateTimeFormat(locale, { month: 'long' }).format(new Date(2000, monthNumber - 1, 1));
     };
    let periods = [];
     const board = $('ocBoard');

    board.addEventListener('click', event => {
        const person = event.target.closest('.oc-person-open');
        if (person && board.contains(person)) {
            renderDetail(currentRows, person.dataset.personKind, person.dataset.personName);
            return;
        }
        const back = event.target.closest('.oc-back');
        if (back && board.contains(back)) renderHome(currentRows);
    });

    let currentRows = [];

    function sameName(left, right) {
        return clean(left).toLocaleLowerCase() === clean(right).toLocaleLowerCase();
    }

    function uniqueNames(rows, key) {
        const seen = new Set();
        return rows
            .map(row => clean(row[key]))
            .filter(name => name && !seen.has(name.toLocaleLowerCase()) && seen.add(name.toLocaleLowerCase()));
    }

    function node(name, role, kind = 'role', clickable = false, personKind = '') {
        return { name, role, kind, clickable, personKind, children: [] };
    }

    function addChild(parent, name, role, kind = 'role', clickable = false, personKind = '') {
        const existing = parent.children.find(child =>
            sameName(child.name, name) && child.role === role && child.kind === kind
        );
        if (existing) return existing;
        const child = node(name, role, kind, clickable, personKind);
        parent.children.push(child);
        return child;
    }

    function buildHomeTree(rows) {
        const rootNode = node(d.generalManagerName, d.generalManager, 'root');
        const assistant = addChild(rootNode, d.assistantGeneralManagerName, d.assistantGeneralManager);

        uniqueNames(rows, 'operationDirector').forEach(directorName => {
            const directorRows = rows.filter(row => sameName(row.operationDirector, directorName));
            const director = addChild(assistant, directorName, d.operationDirector, 'director', true, 'director');
            uniqueNames(directorRows, 'operationManager').forEach(managerName => {
                addChild(director, managerName, d.operationManager, 'manager', true, 'manager');
            });
        });

        return rootNode;
    }

    function avatarIcon(kind) {
        if (kind === 'store') return 'bi-shop';
        if (kind === 'leader') return 'bi-person-check-fill';
        return 'bi-person-fill';
    }

    function nodeMarkup(item) {
        const visualKind = item.kind || 'role';
        const classes = `oc-node oc-${visualKind}${item.clickable ? ' oc-person-open' : ''}`;
        const attrs = item.clickable
            ? ` type="button" data-person-kind="${esc(item.personKind)}" data-person-name="${esc(item.name)}"`
            : '';
        const tag = item.clickable ? `<button class="${classes}"${attrs}>` : `<div class="${classes}">`;
        const close = item.clickable ? '</button>' : '</div>';
        const href = item.kind === 'store' ? `${d.areaPrefix}/dashboard/storeprofile?store=${encodeURIComponent(item.name)}` : '';
        const nameMarkup = href
            ? `<a class="oc-store-link" href="${href}" title="${esc(item.name)}"><strong>${esc(item.name)}</strong></a>`
            : `<strong>${esc(item.name)}</strong>`;
        const children = item.children.length ? `<ul>${item.children.map(nodeMarkup).join('')}</ul>` : '';
        return `<li class="oc-item oc-item-parent-${visualKind}">${tag}<div class="oc-avatar"><i class="bi ${avatarIcon(item.kind)}"></i></div>${nameMarkup}<small>${esc(item.role)}</small>${close}${children}</li>`;
    }

    function buildDetailTree(rows, personKind, personName) {
        const isDirector = personKind === 'director';
        const filterKey = isDirector ? 'operationDirector' : 'operationManager';
        const selectedRole = isDirector ? d.operationDirector : d.operationManager;
        const rootNode = node(personName, selectedRole, 'root');
        const scopedRows = rows.filter(row => sameName(row[filterKey], personName));
        const levels = isDirector
            ? [
                ['operationManager', d.operationManager, 'manager'],
                ['seniorOperationConsultant', d.seniorOperationConsultant, 'senior'],
                ['operationConsultant', d.operationConsultant, 'consultant'],
                ['headManager', d.headManager, 'head'],
                ['storeName', d.store, 'store'],
            ]
            : [
                ['seniorOperationConsultant', d.seniorOperationConsultant, 'senior'],
                ['operationConsultant', d.operationConsultant, 'consultant'],
                ['headManager', d.headManager, 'head'],
                ['storeName', d.store, 'store'],
            ];

        scopedRows.forEach(row => {
            let parent = rootNode;
            levels.forEach(([key, role, kind]) => {
                const value = clean(row[key]);
                if (!value) return;
                parent = addChild(parent, value, role, kind);
            });
        });
        return rootNode;
    }

    function renderHome(rows) {
        if (!rows.length) {
            board.innerHTML = `<div class="oc-empty"><i class="bi bi-diagram-3 fs-2 d-block mb-2"></i>${esc(d.noData)}</div>`;
            return;
        }
        const rootNode = buildHomeTree(rows);
        board.innerHTML = `<div class="oc-home-guide"><i class="bi bi-hand-index-thumb"></i>${esc(d.clickToExtend)}</div><div class="oc-tree"><ul>${nodeMarkup(rootNode)}</ul></div>`;
    }

    function renderDetail(rows, personKind, personName) {
        const tree = buildDetailTree(rows, personKind, personName);
        const content = tree.children.length
            ? `<div class="oc-tree oc-detail-tree"><ul>${nodeMarkup(tree)}</ul></div>`
            : `<div class="oc-detail-empty">${esc(d.noSubordinates)}</div>`;
        board.innerHTML = `<div class="oc-detail-view"><button class="oc-back" type="button"><i class="bi bi-arrow-left"></i>${esc(d.back)}</button>${content}</div>`;
    }

    async function loadRows() {
        const month = $('ocMonth').value;
        const year = $('ocYear').value;
         if (!month || !year) {
             $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
             return;
         }
        $('ocBoard').innerHTML = `<div class="oc-loading"><span class="spinner-border spinner-border-sm"></span>${esc(d.loading)}</div>`;
        try {
            const response = await fetch(`/api/dashboard/operation-chart?month=${encodeURIComponent(month)}&year=${encodeURIComponent(year)}`, { credentials: 'same-origin' });
            if (!response.ok) throw new Error('operation-chart');
            currentRows = await response.json();
            renderHome(currentRows);
        } catch {
            $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
        }
    }

    async function init() {
        try {
            const response = await fetch('/api/dashboard/available-periods', { credentials: 'same-origin' });
            periods = response.ok ? await response.json() : [];
        } catch { periods = []; }
         const yearValues = [...new Set(
             periods
                 .map(p => Number(p.year))
                 .filter(year => Number.isInteger(year) && year > 0)
         )].sort((a, b) => b - a);
        $('ocYear').innerHTML = yearValues.map(y => `<option value="${y}">${y}</option>`).join('');
        const selectedYear = yearValues[0];
         const monthsForYear = () => periods
             .filter(p => Number(p.year) === Number($('ocYear').value))
             .filter(p => Number.isInteger(Number(p.month)) && Number(p.month) >= 1 && Number(p.month) <= 12)
             .sort((a, b) => Number(b.month) - Number(a.month));
        const refillMonths = () => {
            const list = monthsForYear();
             $('ocMonth').innerHTML = list
                 .map(p => `<option value="${Number(p.month)}">${esc(monthLabel(p.month))}</option>`)
                 .join('');
        };
        $('ocYear').addEventListener('change', () => { refillMonths(); loadRows(); });
        $('ocMonth').addEventListener('change', loadRows);
        if (!selectedYear) {
            $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
            return;
        }
        $('ocYear').value = selectedYear;
        refillMonths();
        loadRows();
    }
    init();
})();
</script>