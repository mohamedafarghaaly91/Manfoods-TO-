@{
    var operationChartArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase)
        ? "/admin"
        : "/home";
}

<style>
 .oc-page { --oc-accent:#e5a11b; --oc-line:#8fd1e3; }
 .oc-head { display:flex; align-items:flex-start; justify-content:space-between; gap:18px; flex-wrap:wrap; margin-bottom:18px; }
 .oc-head h1 { margin:0; font-size:clamp(1.45rem,2.5vw,2.15rem); }
 .oc-head p { margin:6px 0 0; color:var(--text-2); font-size:13px; }
 .oc-filters { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
 .oc-filter { display:flex; align-items:center; gap:7px; padding:8px 11px; border:1px solid var(--card-border); border-radius:9px; background:var(--card-bg); color:var(--text-2); font-size:12px; }
 .oc-filter select { min-width:105px; border:0; outline:0; background:transparent; color:var(--text); font-weight:700; }
 .oc-meta { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; color:var(--text-2); font-size:12px; }
 .oc-legend { display:flex; flex-wrap:wrap; gap:7px; }
 .oc-legend span { display:inline-flex; align-items:center; gap:5px; padding:4px 8px; border:1px solid var(--card-border); border-radius:999px; background:var(--card-bg); }
 .oc-legend i { color:var(--oc-accent); }
 .oc-board { overflow:auto; min-height:480px; padding:32px 28px 52px; border:1px solid var(--card-border); border-radius:var(--radius-lg); background:radial-gradient(circle at 50% 0%, color-mix(in srgb,var(--oc-line) 11%,transparent), transparent 34%), var(--card-bg); box-shadow:var(--shadow-sm); }
 .oc-tree { display:flex; justify-content:center; min-width:max-content; direction:ltr; }
 .oc-tree ul { position:relative; display:flex; justify-content:center; gap:32px; margin:0; padding:48px 14px 0; list-style:none; }
 .oc-tree > ul { padding-top:0; }
 .oc-tree li { position:relative; display:flex; flex-direction:column; align-items:center; padding:48px 10px 0; }
 .oc-tree > ul > li { padding-top:0; }
 .oc-tree li::before,.oc-tree li::after { position:absolute; top:23px; z-index:0; content:""; border-top:2px dotted var(--oc-line); }
 .oc-tree > ul > li::before,.oc-tree > ul > li::after { display:none; }
 .oc-tree li::before { right:50%; width:calc(50% + 10px); }
 .oc-tree li::after { left:50%; width:calc(50% + 10px); }
 .oc-tree li:only-child::before,.oc-tree li:only-child::after { display:none; }
 .oc-tree ul ul::before { position:absolute; top:0; left:50%; height:48px; content:""; border-left:2px dotted var(--oc-line); }
 .oc-node { position:relative; z-index:1; display:flex; width:180px; flex-direction:column; align-items:center; border:0; background:transparent; color:var(--text); text-align:center; }
 .oc-node strong { display:block; max-width:190px; margin-top:8px; color:var(--text); font-size:13px; line-height:1.3; }
 .oc-node small { display:block; max-width:190px; margin-top:3px; color:var(--text-2); font-size:10.5px; line-height:1.3; }
  .oc-node:has(.oc-toggle) { cursor:pointer; }
 .oc-avatar { display:flex; width:58px; height:58px; align-items:center; justify-content:center; border:3px solid color-mix(in srgb,var(--node-color) 32%,white); border-radius:50%; background:var(--node-color); box-shadow:0 2px 0 color-mix(in srgb,var(--node-color) 20%,transparent), 0 5px 12px rgba(24,39,75,.13); color:#fff; font-size:25px; }
 .oc-node.oc-root { --node-color:#e5a11b; }
 .oc-node.oc-role { --node-color:#e5a11b; }
 .oc-node.oc-store { --node-color:#3da8c4; cursor:pointer; text-decoration:none; }
 .oc-node.oc-store:hover .oc-avatar { transform:translateY(-2px); box-shadow:0 5px 15px rgba(24,39,75,.2); }
  .oc-store-link { color:inherit; text-decoration:none; }
  .oc-store-link:hover strong { color:var(--node-color); }
 .oc-node.oc-leader { --node-color:#5c9c6a; }
 .oc-node em { display:inline-flex; align-items:center; gap:4px; margin-top:6px; padding:3px 8px; border:1px solid color-mix(in srgb,var(--node-color) 24%,var(--card-border)); border-radius:999px; background:color-mix(in srgb,var(--node-color) 8%,var(--card-bg)); color:var(--node-color); font-size:10px; font-style:normal; font-weight:800; }
 .oc-toggle { position:absolute; right:3px; bottom:1px; display:flex; width:20px; height:20px; align-items:center; justify-content:center; border:1px solid color-mix(in srgb,var(--node-color) 30%,var(--card-border)); border-radius:50%; background:var(--card-bg); color:var(--node-color); cursor:pointer; font-size:10px; transition:transform .18s ease, background .18s ease; }
 .oc-toggle:hover { background:color-mix(in srgb,var(--node-color) 10%,var(--card-bg)); }
 .oc-toggle i { transition:transform .18s ease; }
 .oc-item.is-collapsed > ul { display:none; }
 .oc-item.is-collapsed > .oc-node .oc-toggle i { transform:rotate(-90deg); }
 .oc-item.is-collapsed > .oc-node .oc-toggle { background:color-mix(in srgb,var(--node-color) 9%,var(--card-bg)); }
 .oc-empty { padding:50px 16px; text-align:center; color:var(--text-2); }
 .oc-loading { display:flex; align-items:center; justify-content:center; gap:8px; padding:50px 16px; color:var(--text-2); }
 @@media (max-width:700px) {
     .oc-head { display:block; }
     .oc-filters { margin-top:14px; }
     .oc-board { min-height:400px; padding-right:16px; padding-left:16px; }
     .oc-tree ul { gap:16px; }
     .oc-tree li { padding-right:4px; padding-left:4px; }
     .oc-node { width:150px; }
     .oc-avatar { width:50px; height:50px; font-size:21px; }
 }
</style>

<div class="oc-page" id="operationChartRoot"
     data-area-prefix="@operationChartArea"
     data-title="@L["Page_OperationChart"]"
     data-subtitle="@L["Page_OperationChartSub"]"
     data-loading="@L["OC_Loading"]"
     data-no-data="@L["OC_NoData"]"
     data-stores="@L["OC_Stores"]"
     data-store="@L["OC_Store"]"
     data-general-manager="@L["OC_GeneralManager"]"
     data-assistant-general-manager="@L["OC_AssistantGeneralManager"]"
     data-operation-director="@L["OC_OperationDirector"]"
     data-operation-manager="@L["OC_OperationManager"]"
     data-senior-operation-consultant="@L["OC_SeniorOperationConsultant"]"
     data-operation-consultant="@L["OC_OperationConsultant"]"
     data-head-manager="@L["OC_HeadManager"]"
     data-store-leader="@L["OC_StoreLeader"]">
    <div class="oc-head">
        <div>
            <h1>@L["Page_OperationChart"]</h1>
            <p>@L["Page_OperationChartSub"]</p>
        </div>
        <div class="oc-filters">
            <label class="oc-filter"><i class="bi bi-calendar3"></i><span>@L["Common_Year"]</span><select id="ocYear"></select></label>
            <label class="oc-filter"><i class="bi bi-calendar-month"></i><span>@L["Common_Month"]</span><select id="ocMonth"></select></label>
        </div>
    </div>
    <div class="oc-meta">
        <span id="ocPeriodLabel"></span>
        <div class="oc-legend">
            <span><i class="bi bi-person-badge"></i>@L["OC_Leadership"]</span>
            <span><i class="bi bi-shop"></i>@L["OC_Stores"]</span>
            <span><i class="bi bi-person-check"></i>@L["OC_StoreLeader"]</span>
        </div>
    </div>
    <div class="oc-board" id="ocBoard">
        <div class="oc-loading"><span class="spinner-border spinner-border-sm"></span>@L["OC_Loading"]</div>
    </div>
</div>

<script>
(function () {
    const root = document.getElementById('operationChartRoot');
    if (!root) return;
    const d = root.dataset;
    const $ = id => document.getElementById(id);
    const esc = value => typeof sapEscape === 'function' ? sapEscape(value ?? '') : String(value ?? '');
    const clean = value => String(value ?? '').trim();
     const monthLabel = month => {
         const monthNumber = Number(month);
         if (!Number.isInteger(monthNumber) || monthNumber < 1 || monthNumber > 12) return '';
         const locale = document.documentElement.lang?.toLowerCase().startsWith('ar') ? 'ar-EG' : 'en-US';
         return new Intl.DateTimeFormat(locale, { month: 'long' }).format(new Date(2000, monthNumber - 1, 1));
     };
    let periods = [];
     const board = $('ocBoard');

     board.addEventListener('click', event => {
         let toggle = event.target.closest('.oc-toggle');
         if (!toggle && !event.target.closest('a')) {
             const nodeElement = event.target.closest('.oc-node');
             toggle = nodeElement?.querySelector('.oc-toggle');
         }
         if (!toggle || !board.contains(toggle)) return;
         const item = toggle.closest('.oc-item');
         if (!item) return;
         const expanded = toggle.getAttribute('aria-expanded') === 'true';
         toggle.setAttribute('aria-expanded', String(!expanded));
         item.classList.toggle('is-collapsed', expanded);
     });

    const roleKeys = [
        ['operationDirector', d.operationDirector],
        ['operationManager', d.operationManager],
        ['seniorOperationConsultant', d.seniorOperationConsultant],
        ['operationConsultant', d.operationConsultant],
        ['headManager', d.headManager],
        ['storeName', d.store],
    ];

    function node(name, role, kind = 'role') {
        return { name, role, kind, children: [], stores: 0 };
    }

    function addChild(parent, name, role, kind = 'role') {
        let child = parent.children.find(x => x.name.toLowerCase() === name.toLowerCase() && x.role === role && x.kind === kind);
        if (!child) {
            child = node(name, role, kind);
            parent.children.push(child);
        }
        if (kind === 'store') parent.stores += 1;
        return child;
    }

    function insertRow(rootNode, row) {
        let parent = rootNode;
        for (const [key, role] of roleKeys) {
            const value = clean(row[key]);
            if (!value) continue;
            const kind = key === 'storeName' ? 'store' : 'role';
            parent = addChild(parent, value, role, kind);
        }
        const leader = clean(row.storeLeader);
        if (leader && parent.kind === 'store') addChild(parent, leader, d.storeLeader, 'leader');
    }

    function storeCount(item) {
        if (item.kind === 'store') return 1;
        return item.children.reduce((total, child) => total + storeCount(child), 0);
    }

    function nodeMarkup(item) {
         const nodeClass = `oc-node oc-${item.kind === 'store' ? 'store' : item.kind === 'leader' ? 'leader' : item.kind === 'root' ? 'root' : 'role'}`;
        const href = item.kind === 'store' ? `${d.areaPrefix}/dashboard/storeprofile?store=${encodeURIComponent(item.name)}` : '';
         const icon = item.kind === 'store' ? 'bi-shop' : item.kind === 'leader' ? 'bi-person-check-fill' : 'bi-person-fill';
         const nameMarkup = href
             ? `<a class="oc-store-link" href="${href}" title="${esc(item.name)}"><strong>${esc(item.name)}</strong></a>`
             : `<strong>${esc(item.name)}</strong>`;
        const count = item.kind === 'store' || item.kind === 'leader' ? '' : `<em>${storeCount(item)} ${esc(d.stores)}</em>`;
         const toggle = item.children.length
             ? `<button class="oc-toggle" type="button" aria-expanded="true" aria-label="${esc(item.name)}"><i class="bi bi-chevron-down"></i></button>`
             : '';
         const children = item.children.length ? `<ul>${item.children.map(nodeMarkup).join('')}</ul>` : '';
         return `<li class="oc-item"><div class="${nodeClass}"><div class="oc-avatar"><i class="bi ${icon}"></i></div>${nameMarkup}<small>${esc(item.role)}</small>${count}${toggle}</div>${children}</li>`;
    }

    function render(rows) {
        if (!rows.length) {
            board.innerHTML = `<div class="oc-empty"><i class="bi bi-diagram-3 fs-2 d-block mb-2"></i>${esc(d.noData)}</div>`;
            return;
        }
        const rootNode = node('علاء فتحي', d.generalManager, 'root');
        const assistant = addChild(rootNode, 'عصام رضا', d.assistantGeneralManager);
        rows.forEach(row => insertRow(assistant, row));
        $('ocPeriodLabel').textContent = `${$('ocMonth').selectedOptions[0]?.textContent ?? ''} ${$('ocYear').value}`;
         board.innerHTML = `<div class="oc-tree"><ul>${nodeMarkup(rootNode)}</ul></div>`;
    }

    async function loadRows() {
        const month = $('ocMonth').value;
        const year = $('ocYear').value;
         if (!month || !year) {
             $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
             return;
         }
        $('ocBoard').innerHTML = `<div class="oc-loading"><span class="spinner-border spinner-border-sm"></span>${esc(d.loading)}</div>`;
        try {
            const response = await fetch(`/api/dashboard/operation-chart?month=${encodeURIComponent(month)}&year=${encodeURIComponent(year)}`, { credentials: 'same-origin' });
            if (!response.ok) throw new Error('operation-chart');
            render(await response.json());
        } catch {
            $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
        }
    }

    async function init() {
        try {
            const response = await fetch('/api/dashboard/available-periods', { credentials: 'same-origin' });
            periods = response.ok ? await response.json() : [];
        } catch { periods = []; }
         const yearValues = [...new Set(
             periods
                 .map(p => Number(p.year))
                 .filter(year => Number.isInteger(year) && year > 0)
         )].sort((a, b) => b - a);
        $('ocYear').innerHTML = yearValues.map(y => `<option value="${y}">${y}</option>`).join('');
        const selectedYear = yearValues[0];
         const monthsForYear = () => periods
             .filter(p => Number(p.year) === Number($('ocYear').value))
             .filter(p => Number.isInteger(Number(p.month)) && Number(p.month) >= 1 && Number(p.month) <= 12)
             .sort((a, b) => Number(b.month) - Number(a.month));
        const refillMonths = () => {
            const list = monthsForYear();
             $('ocMonth').innerHTML = list
                 .map(p => `<option value="${Number(p.month)}">${esc(monthLabel(p.month))}</option>`)
                 .join('');
        };
        $('ocYear').addEventListener('change', () => { refillMonths(); loadRows(); });
        $('ocMonth').addEventListener('change', loadRows);
        if (!selectedYear) {
            $('ocBoard').innerHTML = `<div class="oc-empty">${esc(d.noData)}</div>`;
            return;
        }
        $('ocYear').value = selectedYear;
        refillMonths();
        loadRows();
    }
    init();
})();
</script>