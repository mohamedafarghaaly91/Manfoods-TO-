@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
}
<style>
.sap-back-btn { display:inline-flex; align-items:center; gap:6px; font-size:13.5px; font-weight:600; color:var(--text-2); text-decoration:none; margin-bottom:14px; }
.sap-back-btn:hover { color:var(--red); }
.sap-back-btn i { font-size:12px; }
[dir="rtl"] .sap-back-btn i { transform:scaleX(-1); }
.sap-kpi-label { font-size:11px; color:var(--text-3); }
.sap-kpi-value { font-size:22px; font-weight:700; margin-top:2px; }
.sap-meta-label { font-size:11px; color:var(--text-3); }
.sap-rec-item { border-left:3px solid var(--red); padding:8px 12px; background:var(--card-bg-2); border-radius:8px; }
.sap-rec-category { font-size:10.5px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; font-weight:700; }
.sap-note-item { border-bottom:1px solid var(--card-border); padding-bottom:10px; }
</style>

<a class="sap-back-btn" href="@(__areaPrefix)/dashboard/storeactionplans">
    <i class="bi bi-arrow-left"></i>@L["Common_Back"]
</a>

<div class="page-header">
    <div>
        <h1 class="page-title" id="sapdStoreName">@L["Page_StoreActionPlans"]</h1>
        <p class="page-subtitle" id="sapdSubtitle"></p>
    </div>
</div>

<div id="sapdContent"
     data-status-active="@L["SAP_StatusActive"]"
     data-status-resolved="@L["SAP_StatusResolved"]"
     data-status-none="@L["SAP_StatusNone"]"
     data-no-issues="@L["SAP_NoIssuesDetected"]"
     data-kpi-turnover="@L["SAP_KpiTurnoverRate"]"
     data-kpi-early-leaver="@L["SAP_KpiEarlyLeaverRate"]"
     data-kpi-retention="@L["SAP_KpiRetentionRate"]"
     data-meta-responsible="@L["SAP_Responsible"]"
     data-meta-created="@L["SAP_MetaCreated"]"
     data-meta-resolved="@L["SAP_MetaResolvedDate"]"
     data-meta-healthy-streak="@L["SAP_MetaHealthyStreak"]"
     data-healthy-streak-suffix="@L["SAP_HealthyStreakSuffix"]"
     data-detected-issues="@L["SAP_DetectedIssues"]"
     data-recommendations="@L["SAP_Recommendations"]"
     data-no-recommendations="@L["SAP_NoRecommendationsYet"]"
     data-notes="@L["SAP_Notes"]"
     data-no-notes="@L["SAP_NoNotesYet"]"
     data-note-placeholder="@L["SAP_NotePlaceholder"]"
     data-add-note="@L["SAP_AddNote"]"
     data-note-required="@L["SAP_NoteRequired"]"
     data-note-add-failed="@L["SAP_NoteAddFailed"]"
     data-note-add-failed-retry="@L["SAP_NoteAddFailedRetry"]"
     data-no-store-selected="@L["SAP_NoStoreSelected"]"
     data-no-access="@L["SAP_NoAccessOrNotFound"]">
    <div class="text-center py-5 text-muted">
        <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["SAP_Loading"]
    </div>
</div>

<script src="~/js/store-action-plan.js" asp-append-version="true"></script>
<script>
/* Store Action Plan detail — one store's plan, recommendations and notes.
   Store comes from the ?store= query string (same convention the Turnover
   page uses when linked from the Stores page), not a route segment, since
   store names can contain spaces/characters that don't belong in a path. */
const sapdContentEl = document.getElementById('sapdContent');
const SAPD_LABELS = {
    active: sapdContentEl.dataset.statusActive,
    resolved: sapdContentEl.dataset.statusResolved,
    none: sapdContentEl.dataset.statusNone,
};

function sapdFmtDate(iso) {
    if (!iso) return '—';
    const d = new Date(iso);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}

function sapdRate(v) {
    return (v === null || v === undefined) ? '—' : Number(v).toFixed(1) + '%';
}

function sapdCurrentStore() {
    return new URLSearchParams(window.location.search).get('store');
}

function sapdRender(data) {
    const d = sapdContentEl.dataset;

    document.getElementById('sapdStoreName').textContent = data.storeName;
    document.title = data.storeName + ' — Workforce Intelligence';

    const meta = sapStatusMeta(data.status, SAPD_LABELS);
    document.getElementById('sapdSubtitle').innerHTML =
        `<span style="background:${SAP_TONE_BG[meta.tone]};color:${SAP_TONE_VAR[meta.tone]};padding:3px 9px;border-radius:20px;font-size:11px;font-weight:700;display:inline-block">${sapEscape(meta.label)}</span>`;

    const resp = data.responsibleParty;
    const respHtml = resp && resp.name
        ? `${sapEscape(resp.name)}${resp.role ? ` <span style="color:var(--text-3)">(${sapEscape(resp.role.replace('_', ' '))})</span>` : ''}`
        : '—';

    if (data.status === 'None') {
        sapdContentEl.innerHTML = `<div class="card-dark empty-state">
            <i class="bi bi-clipboard-check"></i>
            <p>${sapEscape(d.noIssues)}</p>
        </div>`;
        return;
    }

    let html = '';

    html += `<div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="card-dark"><div class="sap-kpi-label">${sapEscape(d.kpiTurnover)}</div><div class="sap-kpi-value">${sapdRate(data.baselineTurnoverRate)}</div></div></div>
        <div class="col-sm-4"><div class="card-dark"><div class="sap-kpi-label">${sapEscape(d.kpiEarlyLeaver)}</div><div class="sap-kpi-value">${sapdRate(data.baselineEarlyLeaverRate)}</div></div></div>
        <div class="col-sm-4"><div class="card-dark"><div class="sap-kpi-label">${sapEscape(d.kpiRetention)}</div><div class="sap-kpi-value">${sapdRate(data.baselineRetentionRate)}</div></div></div>
    </div>`;

    html += `<div class="card-dark mb-4">
        <div class="d-flex flex-wrap gap-4 mb-3">
            <div><div class="sap-meta-label">${sapEscape(d.metaResponsible)}</div><div class="fw-semibold mt-1">${respHtml}</div></div>
            <div><div class="sap-meta-label">${sapEscape(d.metaCreated)}</div><div class="fw-semibold mt-1">${sapdFmtDate(data.createdAt)}</div></div>
            ${data.status === 'Resolved' ? `<div><div class="sap-meta-label">${sapEscape(d.metaResolved)}</div><div class="fw-semibold mt-1">${sapdFmtDate(data.resolvedAt)}</div></div>` : ''}
            <div><div class="sap-meta-label">${sapEscape(d.metaHealthyStreak)}</div><div class="fw-semibold mt-1">${data.healthyStreakCount} ${sapEscape(d.healthyStreakSuffix)}</div></div>
        </div>
        <div class="sap-meta-label mb-1">${sapEscape(d.detectedIssues)}</div>
        <div style="white-space:pre-line;font-size:13.5px;color:var(--text-2)">${sapEscape(data.detectedIssuesSummary) || '—'}</div>
    </div>`;

    const recs = data.recommendations || [];
    html += `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-3">${sapEscape(d.recommendations)}</h6>
        ${recs.length === 0 ? `<p class="text-muted-custom mb-0">${sapEscape(d.noRecommendations)}</p>` : `
        <div class="d-flex flex-column gap-2">
            ${recs.map(r => `
                <div class="sap-rec-item">
                    <div class="sap-rec-category">${sapEscape(r.category)}</div>
                    <div style="font-size:13.5px;margin-top:2px">${sapEscape(r.recommendationText)}</div>
                </div>
            `).join('')}
        </div>`}
    </div>`;

    const notes = data.notes || [];
    html += `<div class="card-dark mb-4">
        <h6 class="fw-bold mb-3">${sapEscape(d.notes)}</h6>
        <div class="d-flex flex-column gap-3 mb-3" id="sapdNotesList">
            ${notes.length === 0 ? `<p class="text-muted-custom mb-0">${sapEscape(d.noNotes)}</p>` : notes.map(n => `
                <div class="sap-note-item">
                    <div class="d-flex justify-content-between align-items-baseline gap-2">
                        <span class="fw-semibold" style="font-size:13px">${sapEscape(n.authorName)}${n.authorRole ? ` <span style="color:var(--text-3);font-weight:400">(${sapEscape(n.authorRole.replace('_', ' '))})</span>` : ''}</span>
                        <span style="font-size:11px;color:var(--text-3);white-space:nowrap">${sapdFmtDate(n.createdAt)}</span>
                    </div>
                    <div style="font-size:13.5px;color:var(--text-2);margin-top:4px;white-space:pre-line">${sapEscape(n.noteText)}</div>
                </div>
            `).join('')}
        </div>
        ${data.canAddNotes ? `
        <div class="d-flex flex-column gap-2">
            <textarea id="sapdNoteInput" rows="3" class="form-control form-control-dark" placeholder="${sapEscape(d.notePlaceholder)}"></textarea>
            <div id="sapdNoteError" class="small" style="display:none;color:oklch(0.6 0.22 22)"></div>
            <button class="btn-primary align-self-start" id="sapdAddNoteBtn" type="button" onclick="sapdSubmitNote()"><i class="bi bi-plus-lg me-1"></i>${sapEscape(d.addNote)}</button>
        </div>` : ''}
    </div>`;

    sapdContentEl.innerHTML = html;
}

async function sapdLoad() {
    const store = sapdCurrentStore();
    const d = sapdContentEl.dataset;

    if (!store) {
        sapdContentEl.innerHTML = `<div class="card-dark empty-state"><i class="bi bi-shop"></i><p>${sapEscape(d.noStoreSelected)}</p></div>`;
        return;
    }

    const data = await sapFetchJson('/api/store-action-plan?store=' + encodeURIComponent(store));
    if (!data) {
        document.getElementById('sapdStoreName').textContent = store;
        sapdContentEl.innerHTML = `<div class="card-dark empty-state"><i class="bi bi-lock"></i><p>${sapEscape(d.noAccess)}</p></div>`;
        return;
    }

    sapdRender(data);
}

async function sapdSubmitNote() {
    const store = sapdCurrentStore();
    const textEl = document.getElementById('sapdNoteInput');
    const errEl = document.getElementById('sapdNoteError');
    const btn = document.getElementById('sapdAddNoteBtn');
    const d = sapdContentEl.dataset;
    const text = (textEl.value || '').trim();

    errEl.style.display = 'none';
    if (!text) {
        errEl.textContent = d.noteRequired;
        errEl.style.display = 'block';
        return;
    }

    btn.disabled = true;
    try {
        const res = await fetch(`/api/store-action-plan/${encodeURIComponent(store)}/notes`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ noteText: text })
        });

        if (!res.ok) {
            const msg = await res.json().catch(() => null);
            errEl.textContent = (typeof msg === 'string' && msg) ? msg : d.noteAddFailed;
            errEl.style.display = 'block';
            btn.disabled = false;
            return;
        }

        await sapdLoad();
    } catch {
        errEl.textContent = d.noteAddFailedRetry;
        errEl.style.display = 'block';
        btn.disabled = false;
    }
}

sapdLoad();
</script>
