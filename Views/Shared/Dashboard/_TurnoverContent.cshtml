<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Turnover Analytics — uses dashboard.js's shared continuous From→To
   period filter (#periodSelect/#fromPeriodSelect/#storeSelect/#omSelect/
   #ocSelect + periodMonth/periodYear/fromPeriodMonth/fromPeriodYear/
   storeFilter/omFilter/ocFilter/buildQuery()) instead of a page-specific
   discrete Year+Months picker, so the same range filter behaves identically
   across every page. dashboard.js's own loadPeriods() (called at the bottom
   of dashboard.js) drives initial load. */

function tvMonthShortName(m) {
    return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' });
}

/* Same title-badge helper as the Workforce page (rangeFilterBadge lives in
   dashboard.js) — captures each title's original text once, so repeated
   loadAll() calls on filter change don't stack badges. */
const tvTitleBase = {};
function tvSetTitleBadge(id, affected) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!(id in tvTitleBase)) tvTitleBase[id] = el.textContent;
    el.innerHTML = tvTitleBase[id] + ' ' + rangeFilterBadge(isPeriodRangeActive(), affected);
}

/* Expands the selected From→To range into an ordered list of {month, year}. */
function tvExpandRange(fromM, fromY, toM, toY) {
    if (!fromM || !fromY || !toM || !toY) return [];
    let m = fromM, y = fromY;
    if (y > toY || (y === toY && m > toM)) { [m, y, toM, toY] = [toM, toY, m, y]; }
    const out = [];
    while (y < toY || (y === toY && m <= toM)) {
        out.push({ month: m, year: y });
        m++; if (m > 12) { m = 1; y++; }
    }
    return out;
}

const __AREA_PREFIX = '@__areaPrefix';

// Deep link from the Stores page cards: /turnover?store=Downtown. Set before
// dashboard.js's in-flight loadPeriods()/loadStores() resume (single-threaded
// JS: this synchronous code runs before those awaited continuations do).
const __urlStore = new URLSearchParams(window.location.search).get('store');
if (__urlStore) storeFilter = __urlStore;

const _tvOrigLoadStores = loadStores;
loadStores = async function () {
    await _tvOrigLoadStores();
    if (storeFilter) {
        const sel = document.getElementById('storeSelect');
        if (sel) sel.value = storeFilter;
    }
};

/* ── Extra sections (Smart Insights, Store Comparison, OC/OM, Payroll chart) ── */
let tvStoreData = [], tvSortCol = 'turnoverRate', tvSortAsc = false;

function tvRateColor(rate) {
    if (rate >= 15) return { bg: ChartColors.SEMANTIC.BAD, fg: '#fff' };
    if (rate >= 8)  return { bg: ChartColors.SEMANTIC.WARNING_STRONG, fg: '#fff' };
    if (rate >= 4)  return { bg: ChartColors.SEMANTIC.WARNING, fg: '#1C1C27' };
    return { bg: ChartColors.SEMANTIC.GOOD, fg: '#fff' };
}

/* Store Comparison ----------------------------------------- */
function tvRenderStoreTable() {
    const search = (document.getElementById('storeSearch').value || '').toLowerCase();
    let rows = tvStoreData.filter(r =>
        r.storeName.toLowerCase().includes(search) ||
        (r.operationConsultant || '').toLowerCase().includes(search) ||
        (r.operationManager    || '').toLowerCase().includes(search)
    );
    rows.sort((a, b) => {
        const va = a[tvSortCol], vb = b[tvSortCol];
        if (typeof va === 'string') return tvSortAsc ? va.localeCompare(vb) : vb.localeCompare(va);
        return tvSortAsc ? va - vb : vb - va;
    });

    const badge = document.getElementById('storeCountBadge');
    if (badge) badge.textContent = rows.length + ' stores';

    const tbody = document.getElementById('storeTableBody');
    if (!rows.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">No matching stores.</td></tr>';
        return;
    }
    tbody.innerHTML = rows.map(r => {
        const c = tvRateColor(r.turnoverRate);
        const rateBadge = `<span style="background:${c.bg};color:${c.fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${r.turnoverRate.toFixed(1)}%</span>`;
        return `<tr>
            <td class="px-3 py-2 fw-semibold"><a href="${__AREA_PREFIX}/dashboard/turnover?store=${encodeURIComponent(r.storeName)}" style="color:inherit;text-decoration:none" onmouseover="this.style.color='oklch(0.5 0.18 25)'" onmouseout="this.style.color='inherit'">${r.storeName}</a></td>
            <td class="px-3 py-2" style="color:oklch(0.5 0.03 258)">${r.operationConsultant || '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2" style="color:oklch(0.5 0.03 258)">${r.operationManager    || '<span class="text-muted">—</span>'}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.GOOD};font-weight:600">+${r.newHires}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.BAD};font-weight:600">${r.resignations}</td>
            <td class="px-3 py-2 text-center">${rateBadge}</td>
        </tr>`;
    }).join('');
}

async function tvLoadStoreComparison() {
    tvSetTitleBadge('tvStoreComparisonTitle', true);
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/store-comparison?${buildQuery()}`);
    tvStoreData = data || [];
    tvRenderStoreTable();
}

/* OC / OM Analysis ----------------------------------------- */
function tvRenderOcOmTable(tbodyId, rows) {
    const tbody = document.getElementById(tbodyId);
    if (!rows || !rows.length) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">No data for this period.</td></tr>';
        return;
    }
    tbody.innerHTML = rows.map((r, i) => {
        const c     = tvRateColor(r.avgTurnoverRate);
        const badge = `<span style="background:${c.bg};color:${c.fg};padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${r.avgTurnoverRate.toFixed(1)}%</span>`;
        const rank  = i === 0 ? `<span style="color:${ChartColors.SEMANTIC.BAD}">▲</span>` : i === 1 ? `<span style="color:${ChartColors.SEMANTIC.WARNING_STRONG}">▲</span>` : '<span style="color:#aaa">•</span>';
        return `<tr>
            <td class="px-3 py-2">${rank} <span class="fw-semibold">${r.name}</span></td>
            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.totalHeadcount}</td>
            <td class="px-3 py-2 text-center" style="color:${ChartColors.SEMANTIC.BAD};font-weight:600">${r.totalResignations}</td>
            <td class="px-3 py-2 text-center">${badge}</td>
        </tr>`;
    }).join('');
}

async function tvLoadOcOmAnalysis() {
    tvSetTitleBadge('tvOcTitle', true);
    tvSetTitleBadge('tvOdTitle', true);
    tvSetTitleBadge('tvOmTitle', true);
    tvSetTitleBadge('tvSocTitle', true);
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/oc-om-analysis?${buildQuery()}`);
    tvRenderOcOmTable('ocTableBody', data.ocRows);
    tvRenderOcOmTable('omTableBody', data.omRows);
    tvRenderOcOmTable('socTableBody', data.socRows);
    tvRenderOcOmTable('odTableBody', data.odRows);
}

/* Smart Insights ------------------------------------------- */
async function tvLoadSmartInsights() {
    if (!periodMonth || !periodYear) return;
    const items     = await fetchJson(`/api/dashboard/smart-insights?${buildQuery()}`);
    const container = document.getElementById('insightsContainer');

    if (!items || !items.length) {
        container.innerHTML = '<div class="row g-3"><div class="col-12"><div class="alert alert-secondary py-2">No insights available — upload data for multiple periods to enable trend analysis.</div></div></div>';
        return;
    }

    const colorMap = {
        danger:    { bg: '#fff5f5', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        success:   { bg: '#f0fff4', border: '#198754', text: '#198754' },
        warning:   { bg: '#fffbf0', border: ChartColors.SEMANTIC.WARNING, text: '#9a6c00' },
        secondary: { bg: '#f8f9fa', border: '#6c757d', text: '#6c757d' }
    };

    function tvInsightCard(item) {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6 col-xl-4">
            <div style="background:${c.bg};border-left:4px solid ${c.border};border-radius:8px;padding:14px 16px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:17px"></i>
                    <div>
                        <div style="font-size:13px;font-weight:700;color:${c.text};margin-bottom:3px">${item.title}</div>
                        <div style="font-size:12.5px;color:oklch(0.5 0.03 258);line-height:1.55">${item.description}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }

    // Three rows, grouped by what the insight is about — not just insertion
    // order — so the layout stays stable regardless of which insights fire:
    // 1) headline (highest/best store + overall trend), 2) leadership
    // (highest OC/OM/OD), 3) the up-to-3 spiking stores, labeled so it's
    // clear why the same "Turnover Spike" title can repeat.
    const primary    = items.filter(i => i.group === 'primary');
    const leadership = items.filter(i => i.group === 'leadership');
    const spike      = items.filter(i => i.group === 'spike');

    let html = '';
    if (primary.length)    html += `<div class="row g-3">${primary.map(tvInsightCard).join('')}</div>`;
    if (leadership.length) html += `<div class="row g-3 mt-1">${leadership.map(tvInsightCard).join('')}</div>`;
    if (spike.length) {
        html += `<div class="d-flex align-items-center gap-2 mt-3 mb-2">
            <i class="bi bi-lightning-charge-fill" style="color:${ChartColors.SEMANTIC.WARNING};font-size:13px"></i>
            <span style="font-size:11.5px;font-weight:700;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px">Top ${spike.length} Spiking Store${spike.length > 1 ? 's' : ''} vs Prior Period</span>
        </div>`;
        html += `<div class="row g-3">${spike.map(tvInsightCard).join('')}</div>`;
    }
    container.innerHTML = html;
}

/* Wire up sort headers ------------------------------------- */
document.querySelectorAll('#storeTable .tv-sort').forEach(th => {
    th.addEventListener('click', () => {
        const col = th.dataset.col;
        if (tvSortCol === col) { tvSortAsc = !tvSortAsc; }
        else { tvSortCol = col; tvSortAsc = (col === 'storeName' || col === 'operationConsultant' || col === 'operationManager'); }
        document.querySelectorAll('#storeTable .tv-sort i').forEach(i => i.className = 'bi bi-arrow-down-up text-muted');
        const icon = th.querySelector('i');
        if (icon) icon.className = tvSortAsc ? 'bi bi-sort-up text-danger' : 'bi bi-sort-down text-danger';
        tvRenderStoreTable();
    });
});

/* Search filter -------------------------------------------- */
document.getElementById('storeSearch').addEventListener('input', tvRenderStoreTable);

/* "Top driver" mini-callout beside a chart card header ----- */
function tvRenderTopStat(elId, data) {
    const el = document.getElementById(elId);
    if (!el) return;
    if (!data || !data.length) { el.innerHTML = ''; return; }
    const total = data.reduce((s, d) => s + d.value, 0);
    const top   = data.slice().sort((a, b) => b.value - a.value)[0];
    const pct   = total > 0 ? Math.round(top.value / total * 100) : 0;
    el.innerHTML = `<span class="tv-stat-highlight">${top.label}</span> — ${top.value} (${pct}%)`;
}

async function tvLoadJobTitleStat() {
    const data = await fetchJson(`/api/dashboard/turnover-by-job-title?${buildQuery()}`);
    tvRenderTopStat('jobTitleTopStat', data);
}

