@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
}
<style>
.ac-sort-header { cursor:pointer; user-select:none; white-space:nowrap; }
.ac-sort-header:hover { color:var(--red); }
.ac-sort-icon { font-size:10px; margin-left:4px; opacity:0.35; }
[dir="rtl"] .ac-sort-icon { margin-left:0; margin-right:4px; }
.ac-sort-header.ac-sort-asc .ac-sort-icon,
.ac-sort-header.ac-sort-desc .ac-sort-icon { opacity:1; color:var(--red); }
.ac-sort-header.ac-sort-asc .ac-sort-icon::before { content:"\f235"; }
.ac-sort-header.ac-sort-desc .ac-sort-icon::before { content:"\f229"; }
.ac-sort-header:not(.ac-sort-asc):not(.ac-sort-desc) .ac-sort-icon::before { content:"\f229"; }
.chart-body canvas { direction:ltr; }
.ac-badge { padding:3px 9px; border-radius:20px; font-size:10.5px; font-weight:700; white-space:nowrap; display:inline-block; }
.ac-progress-track { background:var(--card-bg-2); border-radius:20px; height:6px; width:80px; overflow:hidden; }
.ac-progress-fill { height:100%; border-radius:20px; background:oklch(0.62 0.15 155); }
.ac-store-link { text-decoration:none; color:inherit; font-weight:700; }
.ac-store-link:hover { color:var(--red); }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_ActionCenter"]</h1>
        <p class="page-subtitle">@L["Page_ActionCenterSub"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" id="acSearch" class="form-control form-control-dark form-control-sm"
               placeholder="&#xF52A; @L["Common_SearchStore"]" style="width:220px;border-radius:20px">
        <button type="button" class="reset-filters-btn" onclick="acResetFilters()">
            <i class="bi bi-arrow-counterclockwise"></i>@L["Common_ResetFilters"]
        </button>
    </div>
</div>

@{
    var actionCenterGuide = new PageGuideViewModel
    {
        PageKey = "actioncenter",
        Overview = L["Guide_ActionCenter_Overview"],
        FilterNote = L["Guide_ActionCenter_FilterNote"],
        Sections = new List<PageGuideSection>
        {
            new() { Icon = "bi-flag", Title = L["AC_ChartTopReasons"], Body = L["Guide_ActionCenter_Chart_Reasons"] },
            new() { Icon = "bi-geo-alt", Title = L["AC_ChartByRegion"], Body = L["Guide_ActionCenter_Chart_Region"] },
            new() { Icon = "bi-graph-up-arrow", Title = L["AC_ChartTrend"], Body = L["Guide_ActionCenter_Chart_Trend"] },
            new() { Icon = "bi-table", Title = L["AC_StoresTable"], Body = L["Guide_ActionCenter_Chart_StoresTable"] },
        }
    };
}
@await Html.PartialAsync("~/Views/Shared/Dashboard/_PageGuide.cshtml", actionCenterGuide)

<div id="acSummaryCards" class="kpi-grid mb-4">
    <div class="kpi-spinner text-center py-3 w-100">
        <div class="spinner-border spinner-border-sm" style="color:oklch(0.5 0.18 25)"></div>
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <i class="bi bi-lightbulb-fill" style="color:oklch(0.75 0.16 75)"></i>
    <h5 class="mb-0 fw-bold">@L["Common_SmartInsights"]</h5>
    <span class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px">@L["Common_AutoGenerated"]</span>
</div>
<div class="chart-card mb-4" id="acInsightsCard">
    <div id="acInsights">
        <div class="text-center py-3 text-muted">
            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["Common_Loading"]
        </div>
    </div>
</div>

<div class="charts-grid mb-4">
    <div class="chart-card">
        <div class="chart-header"><h6>@L["AC_ChartTopReasons"]</h6><p>@L["AC_ChartTopReasonsSub"]</p></div>
        <div class="chart-body"><canvas id="acReasonsChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["AC_ChartByRegion"]</h6><p>@L["AC_ChartByRegionSub"]</p></div>
        <div class="chart-body"><canvas id="acRegionChart"></canvas></div>
    </div>
</div>

<div class="charts-grid mb-4">
    <div class="chart-card" style="grid-column:1 / -1">
        <div class="chart-header"><h6>@L["AC_ChartTrend"]</h6><p>@L["AC_ChartTrendSub"]</p></div>
        <div class="chart-body"><canvas id="acTrendChart"></canvas></div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
        <div class="section-accent"></div>
        <h5 class="mb-0 fw-bold">@L["AC_StoresTable"]</h5>
        <span id="acCountBadge" class="badge ms-1" style="background:var(--bg-2);color:var(--text-2);font-size:11px"></span>
    </div>
</div>
<div class="chart-card p-0" style="overflow:hidden"
     data-no-data="@L["AC_NoMatchingStores"]"
     data-severity-critical="@L["AC_SeverityCritical"]"
     data-severity-high="@L["AC_SeverityHigh"]"
     data-severity-medium="@L["AC_SeverityMedium"]"
     data-severity-low="@L["AC_SeverityLow"]"
     data-severity-none="@L["AC_SeverityNone"]"
     data-status-active="@L["SAP_StatusActive"]"
     data-status-resolved="@L["SAP_StatusResolved"]"
     data-status-none="@L["SAP_StatusNone"]"
     data-trend-improving="@L["AC_TrendImproving"]"
     data-trend-worsening="@L["AC_TrendWorsening"]"
     data-trend-flat="@L["AC_TrendFlat"]"
     data-trend-new="@L["AC_TrendNew"]"
     data-chronic="@L["AC_Chronic"]"
     data-stalled="@L["AC_Stalled"]">
    <div class="table-responsive" style="max-height:560px;overflow-y:auto">
        <table class="table table-hover mb-0 ac-sortable-table" style="font-size:13px">
            <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                <tr>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="storeName">@L["AC_Store"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="severityRank">@L["AC_Severity"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="planStatus">@L["AC_Status"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="ageDays">@L["AC_Age"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="trendRank">@L["AC_Trend"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2">@L["AC_Progress"]</th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="responsibleName">@L["SAP_Responsible"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2 ac-sort-header" data-sort-key="assignedToName">@L["AC_AssignedTo"]<i class="bi ac-sort-icon"></i></th>
                    <th class="px-3 py-2">@L["AC_Flags"]</th>
                </tr>
            </thead>
            <tbody id="acBody">
                <tr><td colspan="9" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["Common_Loading"]
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script>Chart.register(ChartDataLabels);</script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/store-action-plan.js" asp-append-version="true"></script>
<script>
/* Action Center — company-wide dashboard over the same store_action_plans
   data the legacy Store Action Plan page uses, plus severity/trend/progress
   computed server-side. No period filter: reflects current plan state. */
const __AREA_PREFIX = '@__areaPrefix';
let acStoreData = [];
let acSort = { key: 'severityRank', dir: 'desc' };

const acTableEl = document.querySelector('.ac-sortable-table');
const acTableWrap = acTableEl.closest('.chart-card');
const AC_D = acTableWrap.dataset;

const AC_SEVERITY_META = {
    Critical: { label: AC_D.severityCritical, bg: 'oklch(0.6 0.22 22 / .12)', color: ChartColors.SEMANTIC.BAD },
    High:     { label: AC_D.severityHigh,     bg: 'oklch(0.7 0.19 45 / .14)', color: 'oklch(0.6 0.19 45)' },
    Medium:   { label: AC_D.severityMedium,   bg: 'oklch(0.75 0.16 75 / .14)', color: 'oklch(0.6 0.14 75)' },
    Low:      { label: AC_D.severityLow,      bg: 'var(--card-bg-2)', color: 'var(--text-2)' },
    None:     { label: AC_D.severityNone,     bg: 'oklch(0.62 0.15 155 / .12)', color: 'oklch(0.5 0.15 155)' },
};
const AC_STATUS_META = {
    Active:   { label: AC_D.statusActive, color: 'oklch(0.6 0.14 75)', bg: 'oklch(0.75 0.16 75 / .12)' },
    Resolved: { label: AC_D.statusResolved, color: 'oklch(0.5 0.15 155)', bg: 'oklch(0.62 0.15 155 / .12)' },
    None:     { label: AC_D.statusNone, color: 'var(--text-3)', bg: 'var(--card-bg-2)' },
};
const AC_TREND_META = {
    Improving: { label: AC_D.trendImproving, icon: 'bi-arrow-down-right', color: 'oklch(0.5 0.15 155)' },
    Worsening: { label: AC_D.trendWorsening, icon: 'bi-arrow-up-right', color: ChartColors.SEMANTIC.BAD },
    Flat:      { label: AC_D.trendFlat, icon: 'bi-dash-lg', color: 'var(--text-3)' },
    New:       { label: AC_D.trendNew, icon: 'bi-asterisk', color: 'var(--text-3)' },
};
const AC_SEVERITY_RANK = { Critical: 4, High: 3, Medium: 2, Low: 1, None: 0 };
const AC_TREND_RANK = { Worsening: 3, Flat: 2, New: 1, Improving: 0 };

function acFmtDate(d) {
    if (!d) return '—';
    const dt = new Date(d);
    if (isNaN(dt.getTime())) return '—';
    return dt.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
}

async function acLoadSummary() {
    const s = await sapFetchJson('/api/store-action-plan/action-center/summary');
    if (!s) return;

    document.getElementById('acSummaryCards').innerHTML = `
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-clipboard-pulse"></i></div><div class="kpi-value">${s.totalActive}</div><div class="kpi-label">@L["AC_KpiActive"]</div><div class="kpi-desc">@L["AC_KpiActiveDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon text-danger"><i class="bi bi-exclamation-octagon-fill"></i></div><div class="kpi-value text-danger">${s.criticalCount}</div><div class="kpi-label">@L["AC_KpiCritical"]</div><div class="kpi-desc">@L["AC_KpiCriticalDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-hourglass-bottom"></i></div><div class="kpi-value">${s.stalledCount}</div><div class="kpi-label">@L["AC_KpiStalled"]</div><div class="kpi-desc">@L["AC_KpiStalledDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-arrow-repeat"></i></div><div class="kpi-value">${s.chronicCount}</div><div class="kpi-label">@L["AC_KpiChronic"]</div><div class="kpi-desc">@L["AC_KpiChronicDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-check2-circle"></i></div><div class="kpi-value">${s.resolvedThisMonth}</div><div class="kpi-label">@L["AC_KpiResolvedMonth"]</div><div class="kpi-desc">@L["AC_KpiResolvedMonthDesc"]</div></div>
        <div class="kpi-card"><div class="kpi-icon"><i class="bi bi-speedometer2"></i></div><div class="kpi-value">${s.avgDaysToResolution !== null && s.avgDaysToResolution !== undefined ? s.avgDaysToResolution.toFixed(1) : '—'}</div><div class="kpi-label">@L["AC_KpiAvgDays"]</div><div class="kpi-desc">@L["AC_KpiAvgDaysDesc"]</div></div>
    `;

    acRenderInsights(s);
    acRenderReasonsChart(s.topReasons || []);
    acRenderRegionChart(s.byRegion || []);
    acRenderTrendChart(s.monthlyTrend || []);
}

function acRenderInsights(s) {
    const el = document.getElementById('acInsights');
    const colorMap = {
        danger:    { bg: 'oklch(0.6 0.22 22 / .08)', border: ChartColors.SEMANTIC.BAD, text: ChartColors.SEMANTIC.BAD },
        warning:   { bg: 'oklch(0.75 0.16 75 / .12)', border: ChartColors.SEMANTIC.WARNING, text: 'oklch(0.6 0.14 75)' },
        success:   { bg: 'oklch(0.62 0.15 155 / .1)', border: 'oklch(0.5 0.15 155)', text: 'oklch(0.5 0.15 155)' },
        secondary: { bg: 'var(--bg-2)', border: 'var(--text-3)', text: 'var(--text-2)' },
    };
    const items = [];

    if (s.totalActive === 0) {
        items.push({ icon: 'bi-check-circle-fill', color: 'success', title: '@L["AC_InsightAllClearTitle"]', description: '@L["AC_InsightAllClearDesc"]' });
    } else {
        if (s.criticalCount > 0) {
            items.push({ icon: 'bi-exclamation-octagon-fill', color: 'danger', title: '@L["AC_InsightCriticalTitle"]',
                description: `${s.criticalCount} @L["AC_InsightCriticalDesc"]` });
        }
        if (s.stalledCount > 0) {
            items.push({ icon: 'bi-hourglass-bottom', color: 'warning', title: '@L["AC_InsightStalledTitle"]',
                description: `${s.stalledCount} @L["AC_InsightStalledDesc"]` });
        }
        const topReason = (s.topReasons || [])[0];
        if (topReason) {
            items.push({ icon: 'bi-graph-up-arrow', color: 'secondary', title: '@L["AC_InsightTopReasonTitle"]',
                description: `"${topReason.label}" ${'@L["AC_InsightTopReasonDesc"]'.replace('{0}', topReason.value)}` });
        }
        const topRegion = (s.byRegion || [])[0];
        if (topRegion) {
            items.push({ icon: 'bi-diagram-3-fill', color: 'secondary', title: '@L["AC_InsightTopRegionTitle"]',
                description: `${topRegion.label} ${'@L["AC_InsightTopRegionDesc"]'.replace('{0}', topRegion.value)}` });
        }
        if (s.chronicCount > 0) {
            items.push({ icon: 'bi-arrow-repeat', color: 'warning', title: '@L["AC_InsightChronicTitle"]',
                description: `${s.chronicCount} @L["AC_InsightChronicDesc"]` });
        }
    }

    if (!items.length) { el.innerHTML = `<div class="text-muted" style="font-size:13px">@L["AC_NoInsights"]</div>`; return; }

    el.innerHTML = '<div class="row g-3">' + items.map(item => {
        const c = colorMap[item.color] || colorMap.secondary;
        return `<div class="col-md-6">
            <div style="background:${c.bg};border-left:3px solid ${c.border};border-radius:8px;padding:12px 14px;height:100%">
                <div class="d-flex align-items-start gap-2">
                    <i class="bi ${item.icon} mt-1 flex-shrink-0" style="color:${c.text};font-size:15px"></i>
                    <div>
                        <div style="font-size:12.5px;font-weight:700;color:${c.text};margin-bottom:2px">${sapEscape(item.title)}</div>
                        <div style="font-size:12px;color:var(--text-2);line-height:1.5">${sapEscape(item.description)}</div>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('') + '</div>';
}

let acReasonsChartInst = null, acRegionChartInst = null, acTrendChartInst = null;

function acRenderReasonsChart(items) {
    const ctx = document.getElementById('acReasonsChart');
    if (acReasonsChartInst) acReasonsChartInst.destroy();
    acReasonsChartInst = new Chart(ctx, {
        type: 'bar',
        data: { labels: items.map(i => i.label), datasets: [{ data: items.map(i => i.value), backgroundColor: ChartColors.colorsByLabel(items.map(i => i.label), null), borderRadius: 4, maxBarThickness: 34 }] },
        options: {
            indexAxis: 'y', responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' }
            },
            scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });
}

function acRenderRegionChart(items) {
    const ctx = document.getElementById('acRegionChart');
    if (acRegionChartInst) acRegionChartInst.destroy();
    acRegionChartInst = new Chart(ctx, {
        type: 'bar',
        data: { labels: items.map(i => i.label), datasets: [{ data: items.map(i => i.value), backgroundColor: ChartColors.SEMANTIC.BAD, borderRadius: 4, maxBarThickness: 34 }] },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                datalabels: { anchor: 'center', align: 'center', color: '#fff', font: { size: 11, weight: 'bold' }, formatter: v => v > 0 ? v : '' }
            },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });
}

function acRenderTrendChart(points) {
    const ctx = document.getElementById('acTrendChart');
    if (acTrendChartInst) acTrendChartInst.destroy();
    acTrendChartInst = new Chart(ctx, {
        type: 'line',
        data: {
            labels: points.map(p => p.label),
            datasets: [
                { label: '@L["AC_TrendOpened"]', data: points.map(p => p.opened), borderColor: ChartColors.SEMANTIC.BAD, backgroundColor: 'transparent', tension: 0.3, pointRadius: 3 },
                { label: '@L["AC_TrendResolved"]', data: points.map(p => p.resolved), borderColor: 'oklch(0.5 0.15 155)', backgroundColor: 'transparent', tension: 0.3, pointRadius: 3 },
            ]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: true, position: 'bottom' }, datalabels: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });
}

function acStatusMeta(status) { return AC_STATUS_META[status] || AC_STATUS_META.None; }
function acSeverityMeta(sev) { return AC_SEVERITY_META[sev] || AC_SEVERITY_META.None; }
function acTrendMeta(t) { return AC_TREND_META[t] || AC_TREND_META.New; }

function acRenderTable() {
    const search = (document.getElementById('acSearch').value || '').toLowerCase();
    let rows = acStoreData.filter(r =>
        (r.storeName || '').toLowerCase().includes(search) ||
        (r.responsibleName || '').toLowerCase().includes(search) ||
        (r.assignedToName || '').toLowerCase().includes(search)
    );

    rows = rows.map(r => ({ ...r, severityRank: AC_SEVERITY_RANK[r.severity] ?? 0, trendRank: AC_TREND_RANK[r.trend] ?? 0 }));

    const { key, dir } = acSort;
    rows.sort((a, b) => {
        let av = a[key], bv = b[key];
        if (typeof av === 'string') av = av.toLowerCase();
        if (typeof bv === 'string') bv = bv.toLowerCase();
        if (av === undefined || av === null || av === '') av = dir === 'asc' ? '￿' : '';
        if (bv === undefined || bv === null || bv === '') bv = dir === 'asc' ? '￿' : '';
        if (av < bv) return dir === 'asc' ? -1 : 1;
        if (av > bv) return dir === 'asc' ? 1 : -1;
        return 0;
    });

    document.getElementById('acCountBadge').textContent = rows.length;

    const body = document.getElementById('acBody');
    if (!rows.length) {
        body.innerHTML = `<tr><td colspan="9" class="text-center py-4 text-muted">${sapEscape(AC_D.noData)}</td></tr>`;
        return;
    }

    body.innerHTML = rows.map(r => {
        const sev = acSeverityMeta(r.severity);
        const status = acStatusMeta(r.planStatus);
        const trend = acTrendMeta(r.trend);
        const pct = r.tasksTotal > 0 ? Math.round(r.tasksCompleted / r.tasksTotal * 100) : 0;
        const flags = [
            r.isChronic ? `<span class="ac-badge" style="background:oklch(0.75 0.16 75 / .14);color:oklch(0.6 0.14 75)">${sapEscape(AC_D.chronic)}</span>` : '',
            r.isStalled ? `<span class="ac-badge" style="background:oklch(0.6 0.22 22 / .12);color:${ChartColors.SEMANTIC.BAD}">${sapEscape(AC_D.stalled)}</span>` : '',
        ].filter(Boolean).join(' ');
        const link = r.planId ? `${__AREA_PREFIX}/dashboard/actioncenterdetail?store=${encodeURIComponent(r.storeName)}` : null;
        const storeCell = link
            ? `<a class="ac-store-link" href="${link}">${sapEscape(r.storeName)}</a>`
            : `<span class="fw-semibold">${sapEscape(r.storeName)}</span>`;

        return `<tr>
            <td class="px-3 py-2">${storeCell}</td>
            <td class="px-3 py-2"><span class="ac-badge" style="background:${sev.bg};color:${sev.color}">${sapEscape(sev.label)}</span></td>
            <td class="px-3 py-2"><span class="ac-badge" style="background:${status.bg};color:${status.color}">${sapEscape(status.label)}</span></td>
            <td class="px-3 py-2">${r.planId ? (r.ageDays + 'd') : '—'}</td>
            <td class="px-3 py-2"><i class="bi ${trend.icon}" style="color:${trend.color}"></i> <span style="color:${trend.color};font-size:12px">${sapEscape(trend.label)}</span></td>
            <td class="px-3 py-2">${r.tasksTotal > 0 ? `<div class="d-flex align-items-center gap-2"><div class="ac-progress-track"><div class="ac-progress-fill" style="width:${pct}%"></div></div><span style="font-size:11px;color:var(--text-3)">${r.tasksCompleted}/${r.tasksTotal}</span></div>` : '—'}</td>
            <td class="px-3 py-2">${r.responsibleName ? sapEscape(r.responsibleName) : '—'}</td>
            <td class="px-3 py-2">${r.assignedToName ? sapEscape(r.assignedToName) : '—'}</td>
            <td class="px-3 py-2">${flags || '—'}</td>
        </tr>`;
    }).join('');
}

document.querySelectorAll('.ac-sort-header').forEach(th => {
    th.addEventListener('click', () => {
        const key = th.dataset.sortKey;
        if (acSort.key === key) acSort.dir = acSort.dir === 'asc' ? 'desc' : 'asc';
        else { acSort.key = key; acSort.dir = key === 'severityRank' || key === 'ageDays' || key === 'trendRank' ? 'desc' : 'asc'; }
        document.querySelectorAll('.ac-sort-header').forEach(h => h.classList.remove('ac-sort-asc', 'ac-sort-desc'));
        th.classList.add(acSort.dir === 'asc' ? 'ac-sort-asc' : 'ac-sort-desc');
        acRenderTable();
    });
});

async function acLoadStores() {
    const data = await sapFetchJson('/api/store-action-plan/action-center/stores');
