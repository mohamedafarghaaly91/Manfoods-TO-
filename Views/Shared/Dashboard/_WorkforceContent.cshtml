
<style>
.wf-select-wrap { position:relative; }
.wf-select {
    appearance:none; -webkit-appearance:none;
    background:var(--card-bg); border:1px solid var(--card-border); color:var(--text);
    border-radius:var(--radius-sm); font-size:13.5px; font-weight:600;
    height:42px; padding:0 34px 0 14px; min-width:110px;
    box-shadow:var(--shadow-sm); cursor:pointer;
}
.wf-select:focus { outline:none; border-color:var(--red); box-shadow:0 0 0 3px var(--red-light); }
.wf-select-wrap i { position:absolute; top:50%; right:12px; transform:translateY(-50%); font-size:11px; color:var(--text-3); pointer-events:none; }
[dir="rtl"] .wf-select { padding:0 14px 0 34px; }
[dir="rtl"] .wf-select-wrap i { right:auto; left:12px; }

.wf-gender-body { display:flex; align-items:center; gap:18px; height:220px; }
.wf-gender-canvas-wrap { flex:0 0 44%; height:100%; position:relative; }
.wf-gender-list { flex:1; display:flex; flex-direction:column; gap:10px; }
.wf-gender-row { display:flex; align-items:center; gap:9px; font-size:13px; color:var(--text-2); }
.wf-gender-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; }
.wf-gender-label { flex:1; }
.wf-gender-value { font-weight:700; color:var(--text); }
.wf-gender-pct { font-weight:500; color:var(--text-3); }

.wf-store-gender-mini { display:inline-flex; gap:4px; align-items:center; font-size:11px; color:var(--text-3); }
.wf-store-gender-mini span { display:inline-flex; align-items:center; gap:2px; }
.wf-store-gender-dot { width:7px; height:7px; border-radius:50%; display:inline-block; }

/* Chart.js draws its tick/legend text on <canvas>, which otherwise inherits
   the page's dir="rtl" and reorders labels like "1–2 years" into "years 2–1". */
.chart-body canvas { direction:ltr; }
</style>

<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_Workforce"]</h1>
        <p class="page-subtitle">@L["Page_WorkforceSub"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-end">
        <div class="wf-select-wrap"><select id="fromPeriodSelect" class="wf-select"></select><i class="bi bi-chevron-down"></i></div>
        <div class="wf-select-wrap"><select id="periodSelect" class="wf-select"></select><i class="bi bi-chevron-down"></i></div>
        <div class="wf-select-wrap"><select id="storeSelect" class="wf-select"></select><i class="bi bi-chevron-down"></i></div>
        <div class="wf-select-wrap"><select id="omSelect" class="wf-select"></select><i class="bi bi-chevron-down"></i></div>
        <div class="wf-select-wrap"><select id="ocSelect" class="wf-select"></select><i class="bi bi-chevron-down"></i></div>
        <button type="button" class="reset-filters-btn" onclick="resetFilters()">
            <i class="bi bi-arrow-counterclockwise"></i>@L["Common_ResetFilters"]
        </button>
    </div>
</div>

<div id="kpiCards" class="kpi-grid mb-4">
    <div class="kpi-spinner text-center py-3 w-100">
        <div class="spinner-border spinner-border-sm" style="color:oklch(0.5 0.18 25)"></div>
    </div>
</div>

<!-- ── Headcount composition ──────────────────────────────────────── -->
<div class="charts-grid mb-4">
    <div class="chart-card">
        <div class="chart-header"><h6>@L["Chart_HeadcountByJobTitle"]</h6><p>@L["Chart_HeadcountByJobTitleSub"]</p></div>
        <div class="chart-body"><canvas id="wfJobTitleChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["Chart_HeadcountByTenure"]</h6><p>@L["Chart_HeadcountByTenureSub"]</p></div>
        <div class="chart-body"><canvas id="wfTenureChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["Chart_HeadcountByPayroll"]</h6><p>@L["Chart_HeadcountByPayrollSub"]</p></div>
        <div class="chart-body"><canvas id="wfPayrollChart"></canvas></div>
    </div>
    <div class="chart-card">
        <div class="chart-header"><h6>@L["Chart_HeadcountGender"]</h6><p>@L["Chart_HeadcountGenderSub"]</p></div>
        <div class="wf-gender-body">
            <div class="wf-gender-canvas-wrap"><canvas id="wfGenderChart"></canvas></div>
            <div class="wf-gender-list" id="wfGenderStatsList"></div>
        </div>
    </div>
</div>

<!-- ── Headcount trend (always full history from the selected year onward) ── -->
<div class="chart-card mb-4" style="border-radius:14px">
    <div class="chart-header">
        <h6>@L["Chart_HeadcountTrend"]</h6>
        <p>@L["Chart_HeadcountTrendSub"]</p>
    </div>
    <div class="chart-body"><canvas id="wfHeadcountTrendChart" style="max-height:260px"></canvas></div>
</div>

<!-- ── Headcount by store ─────────────────────────────────────────── -->
<div class="d-flex align-items-center gap-2 mb-3">
    <div class="section-accent"></div>
    <h5 class="mb-0 fw-bold">@L["Workforce_StoreBreakdown"]</h5>
</div>
<div class="chart-card mb-4 p-0" style="overflow:hidden">
    <div class="table-responsive" style="max-height:400px;overflow-y:auto">
        <table class="table table-hover mb-0" style="font-size:13px">
            <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                <tr>
                    <th class="px-3 py-2">@L["Common_StoreName"]</th>
                    <th class="px-3 py-2 text-center">@L["Common_Headcount"]</th>
                    <th class="px-3 py-2">Gender Mix</th>
                </tr>
            </thead>
            <tbody id="wfStoreTableBody">
                <tr><td colspan="3" class="text-center py-4 text-muted">
                    <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>Loading...
                </td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <div class="section-accent"></div>
    <h5 class="mb-0 fw-bold">@L["Common_ByOcOm"]</h5>
</div>
<div class="row g-3">
    <div class="col-lg-6">
        <div class="chart-card p-0 h-100" style="overflow:hidden">
            <div class="chart-header d-flex align-items-center gap-2">
                <i class="bi bi-person-badge" style="color:oklch(0.5 0.18 25);font-size:16px"></i>
                <div><h6 class="mb-0">@L["Common_OperationConsultants"]</h6><p class="mb-0">@L["Common_Headcount"] &amp; @L["Common_TurnoverPct"] by consultant</p></div>
            </div>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                        <tr>
                            <th class="px-3 py-2">Name</th>
                            <th class="px-3 py-2 text-center">Stores</th>
                            <th class="px-3 py-2 text-center">Headcount</th>
                            <th class="px-3 py-2 text-center">Turnover%</th>
                        </tr>
                    </thead>
                    <tbody id="ocTableBody">
                        <tr><td colspan="4" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>Loading...
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="chart-card p-0 h-100" style="overflow:hidden">
            <div class="chart-header d-flex align-items-center gap-2">
                <i class="bi bi-person-gear" style="color:oklch(0.6 0.16 25);font-size:16px"></i>
                <div><h6 class="mb-0">Operation Managers</h6><p class="mb-0">Headcount &amp; turnover by manager</p></div>
            </div>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                        <tr>
                            <th class="px-3 py-2">Name</th>
                            <th class="px-3 py-2 text-center">Stores</th>
                            <th class="px-3 py-2 text-center">Headcount</th>
                            <th class="px-3 py-2 text-center">Turnover%</th>
                        </tr>
                    </thead>
                    <tbody id="omTableBody">
                        <tr><td colspan="4" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.6 0.16 25)"></div>Loading...
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row g-3 mt-1">
    <div class="col-lg-6">
        <div class="chart-card p-0 h-100" style="overflow:hidden">
            <div class="chart-header d-flex align-items-center gap-2">
                <i class="bi bi-person-vcard" style="color:oklch(0.55 0.2 300);font-size:16px"></i>
                <div><h6 class="mb-0">Senior Operation Consultants</h6><p class="mb-0">Headcount &amp; turnover by senior consultant</p></div>
            </div>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                        <tr>
                            <th class="px-3 py-2">Name</th>
                            <th class="px-3 py-2 text-center">Stores</th>
                            <th class="px-3 py-2 text-center">Headcount</th>
                            <th class="px-3 py-2 text-center">Turnover%</th>
                        </tr>
                    </thead>
                    <tbody id="socTableBody">
                        <tr><td colspan="4" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.55 0.2 300)"></div>Loading...
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="chart-card p-0 h-100" style="overflow:hidden">
            <div class="chart-header d-flex align-items-center gap-2">
                <i class="bi bi-person-workspace" style="color:oklch(0.5 0.18 250);font-size:16px"></i>
                <div><h6 class="mb-0">Operation Directors</h6><p class="mb-0">Headcount &amp; turnover by director</p></div>
            </div>
            <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                <table class="table table-hover table-sm mb-0" style="font-size:13px">
                    <thead style="background:var(--bg-2);position:sticky;top:0;z-index:1">
                        <tr>
                            <th class="px-3 py-2">Name</th>
                            <th class="px-3 py-2 text-center">Stores</th>
                            <th class="px-3 py-2 text-center">Headcount</th>
                            <th class="px-3 py-2 text-center">Turnover%</th>
                        </tr>
                    </thead>
                    <tbody id="odTableBody">
                        <tr><td colspan="4" class="text-center py-3 text-muted">
                            <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 250)"></div>Loading...
                        </td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="~/js/chart-colors.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script>
/* ── Workforce page — Year + discrete Months multi-select, same filter
   components as Turnover/Comparisons/90-Day pages. Reuses dashboard.js's
   loadKpis() (via the overridden buildQuery below) for the top KPI cards,
   but does NOT use its loadCharts() (that one is resignation-based) —
   this page renders its own active-headcount composition charts instead. */
function wfMonthShortName(m) { return new Date(2000, m - 1, 1).toLocaleString('default', { month: 'short' }); }

/* ── Composition charts ──────────────────────────────────────────── */
let wfJobTitleChart, wfPayrollChart, wfTenureChart, wfGenderChart;

async function wfLoadJobTitleChart() {
    const data = await fetchJson(`/api/dashboard/headcount-by-job-title?${buildQuery()}`);
    wfJobTitleChart = mkChart(wfJobTitleChart, 'wfJobTitleChart', {
        type: 'bar',
        data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => d.value), backgroundColor: '#6D5DFB', borderRadius: 4 }] },
        options: { indexAxis: 'y', plugins: { legend: { display: false } },
            scales: { x: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } }, y: { grid: { display: false }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadPayrollChart() {
    const data = await fetchJson(`/api/dashboard/headcount-by-payroll-group?${buildQuery()}`);
    wfPayrollChart = mkChart(wfPayrollChart, 'wfPayrollChart', {
        type: 'bar',
        data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => d.value), backgroundColor: '#5B3FE0', borderRadius: 4 }] },
        options: { indexAxis: 'y', plugins: { legend: { display: false } },
            scales: { x: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } }, y: { grid: { display: false }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadTenureChart() {
    const data = await fetchJson(`/api/dashboard/headcount-by-tenure?${buildQuery()}`);
    wfTenureChart = mkChart(wfTenureChart, 'wfTenureChart', {
        type: 'bar',
        data: { labels: data.map(d => d.label), datasets: [{ data: data.map(d => d.value), backgroundColor: '#A78BFA', borderRadius: 4 }] },
        options: { plugins: { legend: { display: false } },
            scales: { x: { grid: { display: false }, ticks: { color: '#5B5875' } }, y: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } } } }
    });
}

async function wfLoadGenderChart() {
    const data = await fetchJson(`/api/dashboard/gender-breakdown?${buildQuery()}`);
    const genderLabels = data.map(d => d.label);
    const genderColors = ChartColors.colorsByLabel(genderLabels, ChartColors.GENDER_COLORS);
    wfGenderChart = mkChart(wfGenderChart, 'wfGenderChart', {
        type: 'doughnut',
        data: { labels: genderLabels, datasets: [{ data: data.map(d => d.value), backgroundColor: genderColors, borderWidth: 0 }] },
        options: { plugins: { legend: { display: false } } }
    });

    const el = document.getElementById('wfGenderStatsList');
    if (!data.length) { el.innerHTML = ''; return; }
    const total = data.reduce((s, d) => s + d.value, 0);
    el.innerHTML = data.map((d, i) => {
        const pct = total > 0 ? Math.round(d.value / total * 100) : 0;
        return `<div class="wf-gender-row">
            <span class="wf-gender-dot" style="background:${genderColors[i]}"></span>
            <span class="wf-gender-label">${d.label}</span>
            <span class="wf-gender-value">${d.value} <span class="wf-gender-pct">(${pct}%)</span></span>
        </div>`;
    }).join('');
}

/* Headcount trend — always full history from the selected year onward,
   unaffected by the Months multi-select (same rule as the Turnover page's
   Monthly Trend chart). */
let wfHeadcountTrendChart;
async function wfLoadHeadcountTrend() {
    const q = new URLSearchParams();
    if (storeFilter) q.set('store', storeFilter);
    if (omFilter)    q.set('om', omFilter);
    if (ocFilter)    q.set('oc', ocFilter);
    if (fromPeriodYear) q.set('sinceYear', fromPeriodYear);
    const data = await fetchJson(`/api/dashboard/headcount-trend?${q.toString()}`);
    const fmt = pk => { const [y, m] = pk.split('-'); return new Date(+y, +m - 1, 1).toLocaleString('default', { month: 'short', year: '2-digit' }); };
    wfHeadcountTrendChart = mkChart(wfHeadcountTrendChart, 'wfHeadcountTrendChart', {
        type: 'line',
        data: {
            labels: data.map(d => fmt(d.label)),
            datasets: [{ data: data.map(d => d.value), borderColor: 'oklch(0.5 0.18 25)', backgroundColor: 'oklch(0.5 0.18 25 / .12)', tension: 0.35, fill: true, pointRadius: 3 }]
        },
        options: { plugins: { legend: { display: false } },
            scales: { x: { grid: { display: false }, ticks: { color: '#5B5875' } }, y: { grid: { color: '#E4E2F5' }, ticks: { color: '#5B5875' } } } }
    });
}

/* Headcount by store, with a simple gender mix per store -------------- */
function wfRenderStoreTable(rows) {
    const tbody = document.getElementById('wfStoreTableBody');
    if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="3" class="text-center py-4 text-muted">No data for this period.</td></tr>'; return; }
    tbody.innerHTML = rows.map(r => {
        const total = Object.values(r.genderBreakdown).reduce((s, v) => s + v, 0) || 1;
        const genderHtml = Object.entries(r.genderBreakdown).map(([label, value]) => {
            const pct = Math.round(value / total * 100);
            const color = ChartColors.GENDER_COLORS[label] || ChartColors.hashColor(label);
            return `<span><span class="wf-store-gender-dot" style="background:${color}"></span>${label} ${pct}%</span>`;
        }).join(' ');
        return `<tr>
            <td class="px-3 py-2 fw-semibold">${r.storeName}</td>
            <td class="px-3 py-2 text-center">${r.headcount}</td>
            <td class="px-3 py-2"><div class="wf-store-gender-mini">${genderHtml}</div></td>
        </tr>`;
    }).join('');
}

async function wfLoadStoreTable() {
    if (!periodMonth || !periodYear) return;
    const q = new URLSearchParams({ month: periodMonth, year: periodYear });
    if (omFilter) q.set('om', omFilter);
    if (ocFilter) q.set('oc', ocFilter);
    const data = await fetchJson(`/api/dashboard/store-headcount-breakdown?${q.toString()}`);
    wfRenderStoreTable(data);
}

/* OC / OM tables (reusing the same rendering approach as Turnover) ------- */
function wfRenderOcOmTable(tbodyId, rows) {
    const tbody = document.getElementById(tbodyId);
    if (!rows || !rows.length) { tbody.innerHTML = '<tr><td colspan="4" class="text-center py-3 text-muted">No data for this period.</td></tr>'; return; }
    tbody.innerHTML = rows.map(r => {
        const bg = r.avgTurnoverRate >= 15 ? ChartColors.SEMANTIC.BAD : r.avgTurnoverRate >= 8 ? ChartColors.SEMANTIC.WARNING_STRONG : r.avgTurnoverRate >= 4 ? ChartColors.SEMANTIC.WARNING : ChartColors.SEMANTIC.GOOD;
        const badge = `<span style="background:${bg};color:#fff;padding:3px 10px;border-radius:12px;font-size:11.5px;font-weight:700">${r.avgTurnoverRate.toFixed(1)}%</span>`;
        return `<tr>
            <td class="px-3 py-2 fw-semibold">${r.name}</td>
            <td class="px-3 py-2 text-center">${r.storeCount}</td>
            <td class="px-3 py-2 text-center">${r.totalHeadcount}</td>
            <td class="px-3 py-2 text-center">${badge}</td>
        </tr>`;
    }).join('');
}

async function wfLoadOcOm() {
    if (!periodMonth || !periodYear) return;
    const data = await fetchJson(`/api/dashboard/oc-om-analysis?${buildQuery()}`);
    wfRenderOcOmTable('ocTableBody', data.ocRows);
    wfRenderOcOmTable('omTableBody', data.omRows);
    wfRenderOcOmTable('socTableBody', data.socRows);
    wfRenderOcOmTable('odTableBody', data.odRows);
}

/* Uses dashboard.js's shared #periodSelect/#fromPeriodSelect/#storeSelect/
   #omSelect/#ocSelect filter bar (periodMonth/periodYear/fromPeriodMonth/
   fromPeriodYear/storeFilter/omFilter/ocFilter/buildQuery()) — the same
   continuous From→To range used on every other page. dashboard.js's own
   loadCharts() (resignation-based) is not used here; only loadKpis() is
   reused, via loadAll below, which dashboard.js's loadPeriods() (called at
   the bottom of dashboard.js) will invoke once periods are loaded. */
loadAll = async function () {
    await Promise.all([
        loadKpis(),
        wfLoadJobTitleChart(),
        wfLoadPayrollChart(),
        wfLoadTenureChart(),
        wfLoadGenderChart(),
        wfLoadHeadcountTrend(),
        wfLoadStoreTable(),
        wfLoadOcOm()
    ]);
};
</script>
