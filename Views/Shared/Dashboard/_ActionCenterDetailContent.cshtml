    {
        PageKey = "actioncenterdetail",
        Overview = L["Guide_ActionCenterDetail_Overview"],
        FilterNote = L["Guide_ActionCenterDetail_FilterNote"],
        Sections = new List<PageGuideSection>
        {
            new() { Icon = "bi-speedometer2", Title = L["AC_ProgressTitle"], Body = L["Guide_ActionCenterDetail_Chart_Kpis"] },
            new() { Icon = "bi-graph-up-arrow", Title = L["AC_MetricTrendTitle"], Body = L["Guide_ActionCenterDetail_Chart_Trend"] },
            new() { Icon = "bi-graph-down-arrow", Title = L["AC_MonthlyTurnoverTitle"], Body = L["Guide_ActionCenterDetail_Chart_MonthlyTurnover"] },
            new() { Icon = "bi-table", Title = L["AC_MonthlyPerfTitle"], Body = L["Guide_ActionCenterDetail_Chart_MonthlyPerf"] },
            new() { Icon = "bi-broadcast", Title = L["AC_Signals"], Body = L["Guide_ActionCenterDetail_Chart_Signals"] },
            new() { Icon = "bi-exclamation-circle", Title = L["SAP_DetectedIssues"], Body = L["Guide_ActionCenterDetail_Chart_Issues"] },
            new() { Icon = "bi-list-check", Title = L["SAP_Recommendations"], Body = L["Guide_ActionCenterDetail_Chart_Recommendations"] },
