@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
}
<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_StoreActionPlans"]</h1>
        <p class="page-subtitle">@L["Page_StoreActionPlansSub"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap align-items-center">
        <input type="text" id="sapSearch" class="form-control form-control-dark form-control-sm"
               placeholder="&#xF52A; @L["Common_SearchStore"]" style="width:220px;border-radius:20px">
        @if (string.Equals(__area, "Admin", StringComparison.OrdinalIgnoreCase))
        {
            <button id="sapRunDetectionBtn" type="button" class="btn-primary btn-sm"
                    style="font-size:12px;padding:7px 13px;border-radius:8px"
                    onclick="sapRunDetection()">
                <i class="bi bi-cpu me-1"></i>Run Detection
            </button>
        }
    </div>
</div>

<div id="sapCardsContainer" class="row g-3"
     data-no-matches="@L["SAP_NoMatchingStores"]"
     data-status-active="@L["SAP_StatusActive"]"
     data-status-resolved="@L["SAP_StatusResolved"]"
     data-status-none="@L["SAP_StatusNone"]"
     data-responsible-label="@L["SAP_Responsible"]">
    <div class="col-12 text-center py-5 text-muted">
        <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>@L["SAP_LoadingStores"]
    </div>
</div>

<script src="~/js/store-action-plan.js" asp-append-version="true"></script>
<script>
/* Store Action Plans — list of accessible stores with their current plan
   status. Self-contained (no dashboard.js dependency, no period selector):
   the backend already resolves accessible stores and plan status against
   the latest period internally. */
const __AREA_PREFIX = '@__areaPrefix';
let sapStoreData = [];

const sapContainerEl = document.getElementById('sapCardsContainer');
const SAP_LABELS = {
    active: sapContainerEl.dataset.statusActive,
    resolved: sapContainerEl.dataset.statusResolved,
    none: sapContainerEl.dataset.statusNone,
};

function sapRenderCards() {
    const search = (document.getElementById('sapSearch').value || '').toLowerCase();
    const rows = sapStoreData.filter(r =>
        (r.storeName || '').toLowerCase().includes(search) ||
        (r.responsibleName || '').toLowerCase().includes(search)
    );

    if (!rows.length) {
        sapContainerEl.innerHTML = `<div class="col-12 empty-state"><i class="bi bi-clipboard-check"></i><p>${sapEscape(sapContainerEl.dataset.noMatches)}</p></div>`;
        return;
    }

    sapContainerEl.innerHTML = rows.map(r => {
        const m = sapStatusMeta(r.planStatus, SAP_LABELS);
        const roleLabel = r.responsibleRole ? sapEscape(r.responsibleRole.replace('_', ' ')) : '';
        return `<div class="col-sm-6 col-lg-4 col-xl-3">
            <a href="${__AREA_PREFIX}/dashboard/storeactionplandetail?store=${encodeURIComponent(r.storeName)}" class="card-dark d-block h-100" style="text-decoration:none;color:inherit">
                <div class="d-flex align-items-start justify-content-between mb-3 gap-2">
                    <h6 class="mb-0 fw-bold" style="font-size:14px">${sapEscape(r.storeName)}</h6>
                    <span style="background:${SAP_TONE_BG[m.tone]};color:${SAP_TONE_VAR[m.tone]};padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap">${sapEscape(m.label)}</span>
                </div>
                <div style="font-size:11px;color:var(--text-3)">${sapEscape(sapContainerEl.dataset.responsibleLabel)}</div>
                <div class="fw-semibold mt-1" style="font-size:13px">
                    ${r.responsibleName ? sapEscape(r.responsibleName) : '—'}${roleLabel ? ` <span style="color:var(--text-3);font-weight:400">(${roleLabel})</span>` : ''}
                </div>
            </a>
        </div>`;
    }).join('');
}

async function sapLoadStores() {
    const data = await sapFetchJson('/api/store-action-plan/stores');
    sapStoreData = data || [];
    sapRenderCards();
}

document.getElementById('sapSearch').addEventListener('input', sapRenderCards);
sapLoadStores();

async function sapRunDetection() {
    const btn = document.getElementById('sapRunDetectionBtn');
    if (!btn) return;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Running…';
    try {
        const r = await fetch('/api/store-action-plan/run-detection', { method: 'POST' });
        const data = r.ok ? await r.json() : null;
        if (r.ok) {
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Done';
            btn.style.background = 'oklch(0.45 0.15 155)';
            await sapLoadStores();
        } else {
            btn.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Failed';
            btn.disabled = false;
        }
    } catch {
        btn.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Error';
        btn.disabled = false;
    }
}
</script>
