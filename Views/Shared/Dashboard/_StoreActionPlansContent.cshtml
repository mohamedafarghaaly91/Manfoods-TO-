@{
    var __area = ViewContext.RouteData.Values["area"]?.ToString();
    var __areaPrefix = string.Equals(__area, "Home", StringComparison.OrdinalIgnoreCase) ? "/home" : "/admin";
}
<div class="page-header">
    <div>
        <h1 class="page-title">@L["Page_StoreActionPlans"]</h1>
        <p class="page-subtitle">@L["Page_StoreActionPlansSub"]</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <input type="text" id="sapSearch" class="form-control form-control-dark form-control-sm"
               placeholder="&#xF52A; @L["Common_SearchStore"]" style="width:220px;border-radius:20px">
    </div>
</div>

<div id="sapCardsContainer" class="row g-3">
    <div class="col-12 text-center py-5 text-muted">
        <div class="spinner-border spinner-border-sm me-2" style="color:oklch(0.5 0.18 25)"></div>Loading stores…
    </div>
</div>

<script>
/* Store Action Plans — list of accessible stores with their current plan
   status. Self-contained (no dashboard.js dependency, no period selector):
   the backend already resolves accessible stores and plan status against
   the latest period internally. */
const __AREA_PREFIX = '@__areaPrefix';
let sapStoreData = [];

function sapEscape(s) {
    if (s === null || s === undefined) return '';
    const div = document.createElement('div');
    div.textContent = String(s);
    return div.innerHTML;
}

async function sapFetchJson(url) {
    const r = await fetch(url);
    return r.ok ? r.json() : [];
}

function sapStatusMeta(status) {
    if (status === 'Active')   return { label: 'Active plan', tone: 'warning' };
    if (status === 'Resolved') return { label: 'Resolved', tone: 'success' };
    return { label: 'No active plan', tone: 'neutral' };
}

const sapToneVar = { success: 'oklch(0.62 0.15 155)', warning: 'oklch(0.75 0.16 75)', neutral: 'var(--text-3)' };
const sapToneBg  = { success: 'oklch(0.62 0.15 155 / .1)', warning: 'oklch(0.75 0.16 75 / .15)', neutral: 'var(--card-bg-2)' };

function sapRenderCards() {
    const search = (document.getElementById('sapSearch').value || '').toLowerCase();
    const rows = sapStoreData.filter(r =>
        (r.storeName || '').toLowerCase().includes(search) ||
        (r.responsibleName || '').toLowerCase().includes(search)
    );

    const container = document.getElementById('sapCardsContainer');
    if (!rows.length) {
        container.innerHTML = '<div class="col-12 empty-state"><i class="bi bi-clipboard-check"></i><p>No matching stores.</p></div>';
        return;
    }

    container.innerHTML = rows.map(r => {
        const m = sapStatusMeta(r.planStatus);
        const roleLabel = r.responsibleRole ? sapEscape(r.responsibleRole.replace('_', ' ')) : '';
        return `<div class="col-sm-6 col-lg-4 col-xl-3">
            <a href="${__AREA_PREFIX}/dashboard/storeactionplandetail?store=${encodeURIComponent(r.storeName)}" class="card-dark d-block h-100" style="text-decoration:none;color:inherit">
                <div class="d-flex align-items-start justify-content-between mb-3 gap-2">
                    <h6 class="mb-0 fw-bold" style="font-size:14px">${sapEscape(r.storeName)}</h6>
                    <span style="background:${sapToneBg[m.tone]};color:${sapToneVar[m.tone]};padding:3px 9px;border-radius:20px;font-size:10px;font-weight:700;white-space:nowrap">${m.label}</span>
                </div>
                <div style="font-size:11px;color:var(--text-3)">Responsible</div>
                <div class="fw-semibold mt-1" style="font-size:13px">
                    ${r.responsibleName ? sapEscape(r.responsibleName) : '—'}${roleLabel ? ` <span style="color:var(--text-3);font-weight:400">(${roleLabel})</span>` : ''}
                </div>
            </a>
        </div>`;
    }).join('');
}

async function sapLoadStores() {
    const data = await sapFetchJson('/api/store-action-plan/stores');
    sapStoreData = data || [];
    sapRenderCards();
}

document.getElementById('sapSearch').addEventListener('input', sapRenderCards);
sapLoadStores();
</script>
