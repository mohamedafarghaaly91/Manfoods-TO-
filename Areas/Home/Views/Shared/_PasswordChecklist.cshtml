@* Live password-requirements checklist. Pair with wwwroot/js/password-policy.js:
   initPasswordChecklist('<new-password-input-id>', 'pwChecklist')
   Duplicated per-area (see also Areas/Admin/Views/Shared and Views/Shared) —
   ASP.NET Core's default area view locations never search the root
   Views/Shared folder, so a single copy there is invisible to Area views. *@
<ul class="pwck-list" id="pwChecklist">
    <li class="pwck-item" data-rule="length"><i class="pwck-icon bi bi-circle"></i> @L["PwPolicy_Length"]</li>
    <li class="pwck-item" data-rule="upper"><i class="pwck-icon bi bi-circle"></i> @L["PwPolicy_Upper"]</li>
    <li class="pwck-item" data-rule="lower"><i class="pwck-icon bi bi-circle"></i> @L["PwPolicy_Lower"]</li>
    <li class="pwck-item" data-rule="digit"><i class="pwck-icon bi bi-circle"></i> @L["PwPolicy_Digit"]</li>
    <li class="pwck-item" data-rule="symbol"><i class="pwck-icon bi bi-circle"></i> @L["PwPolicy_Symbol"]</li>
</ul>
<script src="~/js/password-policy.js" asp-append-version="true"></script>
