<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath="dotnet" arguments=".\MvcApp.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
      <!-- No environmentVariables here on purpose: real secrets (SQLSERVER_CONNECTION_STRING,
           SESSION_SECRET, ASPNETCORE_ENVIRONMENT) are set in the hosting panel's own
           Environment Variables section instead. A value set here would override the
           panel's value on every deploy, since this file ships with the repo. -->
    </aspNetCore>
  </system.webServer>
</configuration>
